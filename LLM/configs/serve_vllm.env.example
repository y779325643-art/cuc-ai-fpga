# Copy to configs/serve_vllm.env on the cloud server and edit as needed.
MODEL_PATH=google/gemma-4-12B-it
HOST=127.0.0.1
PORT=8000
SERVED_MODEL_NAME=cuc-ai-fpga
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=2048
MAX_NUM_SEQS=1
CPU_OFFLOAD_GB=8
DTYPE=bfloat16
TRUST_REMOTE_CODE=false
LIMIT_MM_PER_PROMPT='{"image":0,"audio":0}'
ENFORCE_EAGER=false
