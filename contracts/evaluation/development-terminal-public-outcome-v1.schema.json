{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sr2fpga.local/contracts/evaluation/development-terminal-public-outcome/v1",
  "title": "SR2FPGA Development Terminal Public Outcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "outcome_id", "evaluation_scope", "evaluator_identity",
    "episode_id", "method_condition", "terminal_candidate_sha256",
    "public_contract_sha256", "public_profile_sha256",
    "tool_environment_policy_sha256", "one_shot_ledger_ref",
    "execution_status", "infrastructure_reason", "stage_outcomes",
    "diagnostic_codes", "public_acceptance", "repair_visible",
    "pass_credit_authority", "official_outcome", "vpp_l3"
  ],
  "properties": {
    "contract_version": {"const": "development-terminal-public-outcome-v1"},
    "outcome_id": {"type": "string", "pattern": "^public-outcome-[0-9a-f]{64}$"},
    "evaluation_scope": {"const": "development_terminal_shadow_only"},
    "evaluator_identity": {"const": "development-public-evaluator-v1"},
    "episode_id": {"$ref": "#/$defs/identifier"},
    "method_condition": {"enum": ["M0", "M1", "M2", "M3", "M4", "M5"]},
    "terminal_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "public_contract_sha256": {"$ref": "#/$defs/sha256"},
    "public_profile_sha256": {"$ref": "#/$defs/sha256"},
    "tool_environment_policy_sha256": {"$ref": "#/$defs/sha256"},
    "one_shot_ledger_ref": {"type": "string", "minLength": 1},
    "execution_status": {"enum": ["completed", "not_run"]},
    "infrastructure_reason": {
      "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
    },
    "stage_outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l0", "l1", "public_l2", "l3"],
      "properties": {
        "l0": {"$ref": "#/$defs/stage"},
        "l1": {"$ref": "#/$defs/stage"},
        "public_l2": {"$ref": "#/$defs/stage"},
        "l3": {"$ref": "#/$defs/stage"}
      }
    },
    "public_l2_harness": {"$ref": "#/$defs/public_l2_harness"},
    "diagnostic_codes": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]*$"}
    },
    "public_acceptance": {"type": "boolean"},
    "repair_visible": {"const": false},
    "pass_credit_authority": {"const": false},
    "official_outcome": {"const": false},
    "vpp_l3": {"type": "null"}
  },
  "allOf": [
    {
      "if": {"properties": {"execution_status": {"const": "completed"}}},
      "then": {"properties": {"infrastructure_reason": {"type": "null"}}},
      "else": {"properties": {"infrastructure_reason": {"type": "string", "minLength": 1}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["pass", "fail", "not_run"]},
        "reason": {
          "oneOf": [
            {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]*$"},
            {"type": "null"}
          ]
        }
      }
    },
    "public_l2_harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "harness_id", "manifest_sha256", "bundle_sha256", "reason"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "harness_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "bundle_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
