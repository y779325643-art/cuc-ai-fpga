{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SR2FPGA development shared-checkpoint no-candidate outcome v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "evaluation_scope", "outcome_id", "episode_id", "method_condition", "analysis_population", "episode_pack_ref", "checkpoint_manifest_ref", "paired_block_ref", "semantic_instance_id", "replicate_id", "paired_block_id", "blocked_checkpoint_id", "checkpoint_failure_reason", "execution_status", "semantic_status", "development_vpp_l3", "integrity_violation", "hidden_execution_status", "hidden_semantic_status", "semantic_commit_count", "terminal_candidate_ref", "block_event_refs", "denominator", "official_outcome", "official_authority", "pass_credit_authority", "g3_accepted", "g4b_authorized"],
  "properties": {
    "contract_version": {"const": "development-checkpoint-stop-outcome-v1"},
    "evaluation_scope": {"const": "excluded_development_conformance_only"},
    "outcome_id": {"type": "string", "pattern": "^checkpoint-stop-[0-9a-f]{64}$"},
    "episode_id": {"type": "string", "minLength": 1},
    "method_condition": {"enum": ["M0", "M1", "M3", "M4", "M5"]},
    "analysis_population": {"enum": ["development", "excluded"]},
    "episode_pack_ref": {"$ref": "#/$defs/ref"}, "checkpoint_manifest_ref": {"$ref": "#/$defs/ref"},
    "paired_block_ref": {"$ref": "#/$defs/ref"},
    "semantic_instance_id": {"type": "string", "minLength": 1},
    "replicate_id": {"type": "string", "minLength": 1}, "paired_block_id": {"type": "string", "minLength": 1},
    "blocked_checkpoint_id": {"enum": ["direct_initial_project", "shared_system_his", "skeleton_initial_project"]},
    "checkpoint_failure_reason": {"type": "string", "minLength": 1},
    "execution_status": {"const": "not_run"}, "semantic_status": {"enum": ["not_evaluated", "design_failure"]},
    "development_vpp_l3": {"enum": [false, null]},
    "integrity_violation": {"type": "boolean"},
    "hidden_execution_status": {"const": "not_run"}, "hidden_semantic_status": {"type": "null"},
    "semantic_commit_count": {"const": 0},
    "terminal_candidate_ref": {"type": "null"},
    "block_event_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "denominator": {"type": "object", "additionalProperties": false, "required": ["retained", "replacement_allowed"], "properties": {"retained": {"const": true}, "replacement_allowed": {"const": false}}},
    "official_outcome": {"const": false}, "official_authority": {"const": false},
    "pass_credit_authority": {"const": false}, "g3_accepted": {"const": false}, "g4b_authorized": {"const": false}
  },
  "$defs": {"ref": {
    "type": "object", "additionalProperties": false,
    "required": ["key", "sha256", "size_bytes", "media_type"],
    "properties": {
      "key": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "size_bytes": {"type": "integer", "minimum": 0}, "media_type": {"type": "string", "minLength": 1}
    }
  }}
}
