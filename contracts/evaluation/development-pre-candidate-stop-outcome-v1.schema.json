{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sr2fpga.local/contracts/evaluation/development-pre-candidate-stop-outcome/v1",
  "title": "SR2FPGA Development Pre-Candidate Stop Outcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "outcome_id", "evaluation_scope", "episode_id",
    "method_condition", "analysis_population", "failure_origin",
    "episode_pack_ref", "public_projection_sha256", "method_policy_sha256",
    "planning_kind", "planning_artifact_ref", "method_event_refs",
    "source_method_events_sha256",
    "state_trace", "final_state", "failure", "trajectory_ref",
    "cost_summary_refs", "trajectory_status", "cost", "stage_outcomes",
    "repair", "missingness", "development_vpp_l3_status",
    "development_vpp_l3", "development_vpp_l3_reasons",
    "vpp_l3_status", "vpp_l3", "vpp_l3_reasons", "denominator",
    "reducer_visible", "generation_visible", "repair_visible",
    "terminal_selection_authority",
    "official_outcome", "official_authority", "pass_credit_authority",
    "rq1_evidence", "rq2_evidence", "g3_accepted", "g4b_authorized"
  ],
  "properties": {
    "contract_version": {"const": "development-pre-candidate-stop-outcome-v1"},
    "outcome_id": {
      "type": "string",
      "pattern": "^pre-candidate-stop-outcome-[0-9a-f]{64}$"
    },
    "evaluation_scope": {"const": "excluded_development_conformance_only"},
    "episode_id": {"$ref": "#/$defs/identifier"},
    "method_condition": {"const": "M4"},
    "analysis_population": {"const": "excluded"},
    "failure_origin": {"const": "synthetic_injected"},
    "episode_pack_ref": {"$ref": "#/$defs/artifact_ref"},
    "public_projection_sha256": {"$ref": "#/$defs/sha256"},
    "method_policy_sha256": {"$ref": "#/$defs/sha256"},
    "planning_kind": {"const": "system_his"},
    "planning_artifact_ref": {"$ref": "#/$defs/artifact_ref"},
    "method_event_refs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "source_method_events_sha256": {"$ref": "#/$defs/sha256"},
    "state_trace": {
      "const": [
        "method_prepared", "planning_artifact_emitted", "h_validated",
        "no_complete_candidate"
      ]
    },
    "final_state": {"const": "no_complete_candidate"},
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "error_type", "message"],
      "properties": {
        "stage": {"const": "h0"},
        "error_type": {"const": "HValidationFailed"},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "trajectory_ref": {"$ref": "#/$defs/artifact_ref"},
    "cost_summary_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "trajectory_status": {
      "const": {
        "lineage_complete": false,
        "missing_lineage_reasons": ["terminal_candidate_ref_missing"],
        "terminal_candidate_ref": null,
        "development_terminal_selection_ref": null,
        "development_selected_public_outcome_ref": null,
        "development_terminal_public_outcome_ref": null,
        "development_hidden_outcome_ref": null,
        "development_hidden_conformance_outcome_ref": null
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_axes_classified", "logical_model_calls", "zero_axes",
        "unavailable_axes"
      ],
      "properties": {
        "all_axes_classified": {"const": true},
        "logical_model_calls": {"const": 1},
        "zero_axes": {
          "const": [
            "planner_parser_schema_retries", "outer_repair_attempts",
            "public_tool_calls", "hidden_evaluator_tool_calls",
            "hidden_infrastructure_retries", "eda_time",
            "hidden_evaluator_runtime"
          ]
        },
        "unavailable_axes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "logical_model_calls", "input_tokens", "output_tokens",
              "cached_tokens", "provider_transport_attempts",
              "planner_parser_schema_retries", "outer_repair_attempts",
              "public_tool_calls", "hidden_evaluator_tool_calls",
              "hidden_infrastructure_retries", "wall_time", "eda_time",
              "hidden_evaluator_runtime"
            ]
          }
        }
      }
    },
    "stage_outcomes": {
      "const": {
        "planning": {"status": "pass", "reason": null},
        "h0": {"status": "fail", "reason": "registered_schema_validation_failed"},
        "h1": {"status": "not_run", "reason": "upstream_h0_failed"},
        "h2": {"status": "not_run", "reason": "upstream_h0_failed"},
        "h3": {"status": "not_run", "reason": "upstream_h0_failed"},
        "project_emission": {"status": "not_run", "reason": "upstream_h0_failed"},
        "l0": {"status": "not_run", "reason": "upstream_h0_failed"},
        "l1": {"status": "not_run", "reason": "upstream_h0_failed"},
        "public_l2": {"status": "not_run", "reason": "upstream_h0_failed"},
        "l3": {"status": "not_run", "reason": "upstream_h0_failed"},
        "l4_open": {"status": "not_run", "reason": "upstream_h0_failed"},
        "l4_commercial": {"status": "not_run", "reason": "upstream_h0_failed"}
      }
    },
    "repair": {
      "const": {
        "reconciliation_status": "complete",
        "calls_attempted": 0,
        "transitions": 0,
        "successes": 0,
        "diagnosis_count": 0,
        "valid_patch_count": 0,
        "rerun_count": 0,
        "by_scope": {
          "system_his": {"calls_attempted": 0, "transitions": 0},
          "project": {"calls_attempted": 0, "transitions": 0}
        },
        "skip_reason": "method_contract_disallows_system_his_correction"
      }
    },
    "missingness": {
      "const": {
        "classification": "design_outcome",
        "reason": "h0_failed_before_complete_candidate",
        "retained": true,
        "replacement_allowed": false
      }
    },
    "development_vpp_l3_status": {"const": "evaluated"},
    "development_vpp_l3": {"const": false},
    "development_vpp_l3_reasons": {
      "const": ["h0_failed", "no_complete_candidate"]
    },
    "vpp_l3_status": {"const": "not_evaluated"},
    "vpp_l3": {"type": "null"},
    "vpp_l3_reasons": {
      "const": [
        "official_hidden_outcome_unavailable", "public_authority_not_official"
      ]
    },
    "denominator": {
      "const": {
        "population": "excluded",
        "retained": true,
        "replacement_allowed": false
      }
    },
    "reducer_visible": {"const": true},
    "generation_visible": {"const": false},
    "repair_visible": {"const": false},
    "terminal_selection_authority": {"const": false},
    "official_outcome": {"const": false},
    "official_authority": {"const": false},
    "pass_credit_authority": {"const": false},
    "rq1_evidence": {"const": false},
    "rq2_evidence": {"const": false},
    "g3_accepted": {"const": false},
    "g4b_authorized": {"const": false}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "sha256", "size_bytes", "media_type"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "media_type": {"const": "application/json"}
      }
    }
  }
}
