{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sr2fpga.local/contracts/evaluation/full-pack-outcome-reconciliation/v1",
  "title": "SR2FPGA Excluded Full-Pack Outcome Reconciliation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "evaluation_scope", "smoke_id", "analysis_population",
    "g3_accepted", "g4b_authorized", "official_outcome", "rq1_evidence", "rq2_evidence",
    "source_runner_reconciliation_ref", "method_records", "summary", "blocking_gaps"
  ],
  "properties": {
    "contract_version": {"const": "full-pack-outcome-reconciliation-v1"},
    "evaluation_scope": {"const": "excluded_development_conformance_only"},
    "smoke_id": {"$ref": "#/$defs/identifier"},
    "analysis_population": {"const": "excluded"},
    "g3_accepted": {"const": false},
    "g4b_authorized": {"const": false},
    "official_outcome": {"const": false},
    "rq1_evidence": {"const": false},
    "rq2_evidence": {"const": false},
    "source_runner_reconciliation_ref": {"$ref": "#/$defs/artifact_ref"},
    "method_records": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["method_condition", "episode_id", "outcome_ref"],
        "properties": {
          "method_condition": {"$ref": "#/$defs/method"},
          "episode_id": {"$ref": "#/$defs/identifier"},
          "outcome_ref": {"$ref": "#/$defs/artifact_ref"}
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "method_set", "frozen_episode_count", "retained_episode_count", "replacement_count",
        "vpp_evaluated_count", "vpp_pass_count", "vpp_fail_count", "vpp_not_evaluated_count",
        "repair_calls_attempted", "repair_transitions", "repair_successes", "missingness_counts"
      ],
      "properties": {
        "method_set": {"const": ["M0", "M1", "M2", "M3", "M4", "M5"]},
        "frozen_episode_count": {"const": 6},
        "retained_episode_count": {"const": 6},
        "replacement_count": {"const": 0},
        "vpp_evaluated_count": {"const": 0},
        "vpp_pass_count": {"const": 0},
        "vpp_fail_count": {"const": 0},
        "vpp_not_evaluated_count": {"const": 6},
        "development_vpp_evaluated_count": {"type": "integer", "minimum": 0, "maximum": 6},
        "development_vpp_pass_count": {"type": "integer", "minimum": 0, "maximum": 6},
        "development_vpp_fail_count": {"type": "integer", "minimum": 0, "maximum": 6},
        "development_vpp_not_evaluated_count": {"type": "integer", "minimum": 0, "maximum": 6},
        "repair_calls_attempted": {"type": "integer", "minimum": 0},
        "repair_transitions": {"type": "integer", "minimum": 0},
        "repair_successes": {"type": "integer", "minimum": 0},
        "missingness_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["scoreable_public_record", "design_outcome", "infrastructure_unscorable"],
          "properties": {
            "scoreable_public_record": {"type": "integer", "minimum": 0},
            "design_outcome": {"type": "integer", "minimum": 0},
            "infrastructure_unscorable": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "blocking_gaps": {
      "const": ["official_public_terminal_hidden_authority", "g4b_campaign_authority"]
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "method": {"enum": ["M0", "M1", "M2", "M3", "M4", "M5"]},
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "sha256", "size_bytes", "media_type"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "media_type": {"const": "application/json"}
      }
    }
  }
}
