{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sr2fpga.local/contracts/evaluation/training-qualification-outcome/v1",
  "title": "SR2FPGA Training Qualification Outcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "evaluation_scope", "episode_id", "method_condition_id",
    "terminal_candidate_sha256", "training_split_id", "purpose",
    "public_pack_sha256", "private_pack_sha256", "execution_status",
    "evaluator_evidence_refs"
  ],
  "properties": {
    "contract_version": {"const": "training-qualification-outcome-v1"},
    "evaluation_scope": {"const": "training_qualification"},
    "episode_id": {"$ref": "#/$defs/identifier"},
    "method_condition_id": {"enum": ["M0", "M1", "M2", "M3", "M4", "M5"]},
    "terminal_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "training_split_id": {"$ref": "#/$defs/identifier"},
    "purpose": {"const": "training_release_qualification"},
    "public_pack_sha256": {"$ref": "#/$defs/sha256"},
    "private_pack_sha256": {"$ref": "#/$defs/sha256"},
    "execution_status": {"enum": ["completed", "not_run"]},
    "outcome": {"enum": ["pass", "fail"]},
    "infrastructure_reason": {"type": "string", "minLength": 1},
    "evaluator_evidence_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"execution_status": {"const": "completed"}}},
      "then": {"required": ["outcome"], "not": {"required": ["infrastructure_reason"]}},
      "else": {"required": ["infrastructure_reason"], "not": {"required": ["outcome"]}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}
  }
}
