{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sr2fpga.local/contracts/evaluation/development-l4-qor-provenance/v1",
  "title": "SR2FPGA Development L4 QoR Provenance v1",
  "description": "Development-only provenance attached to one L4 QoR lane. It binds raw evidence hashes and the core tool-environment reference while preserving the explicit gap for the exact L4 tool version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "lane",
    "source_stage",
    "source_stage_status",
    "core_tool_environment_ref",
    "l4_tool_environment_ref",
    "raw_evidence_refs",
    "l4_tool_version_status",
    "l4_tool_version",
    "provenance_status",
    "incomplete_reasons",
    "terminal_binding",
    "pass_credit_authority",
    "official_authority"
  ],
  "properties": {
    "contract_version": {"const": "development-l4-qor-provenance-v1"},
    "lane": {"enum": ["l4_open", "l4_commercial"]},
    "source_stage": {"enum": ["pnr", "l4_commercial"]},
    "source_stage_status": {
      "enum": ["pass", "fail", "not_run", "infrastructure_error"]
    },
    "core_tool_environment_ref": {
      "oneOf": [{"$ref": "#/$defs/artifact_ref"}, {"type": "null"}]
    },
    "l4_tool_environment_ref": {
      "oneOf": [{"$ref": "#/$defs/artifact_ref"}, {"type": "null"}]
    },
    "raw_evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/file_ref"}
    },
    "l4_tool_version_status": {"enum": ["captured", "not_captured", "not_run"]},
    "l4_tool_version": {"type": ["string", "null"]},
    "provenance_status": {"enum": ["complete", "incomplete"]},
    "incomplete_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "stage_not_run",
          "raw_evidence_missing",
          "core_tool_environment_ref_missing",
          "l4_tool_environment_ref_missing",
          "l4_tool_version_not_captured"
        ]
      }
    },
    "terminal_binding": {"const": false},
    "pass_credit_authority": {"const": false},
    "official_authority": {"const": false}
  },
  "allOf": [
    {
      "if": {
        "properties": {"provenance_status": {"const": "complete"}},
        "required": ["provenance_status"]
      },
      "then": {
        "properties": {
          "core_tool_environment_ref": {"$ref": "#/$defs/artifact_ref"},
          "l4_tool_environment_ref": {"$ref": "#/$defs/artifact_ref"},
          "raw_evidence_refs": {"minItems": 1},
          "l4_tool_version_status": {"const": "captured"},
          "l4_tool_version": {"type": "string", "minLength": 1},
          "incomplete_reasons": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"provenance_status": {"const": "incomplete"}},
        "required": ["provenance_status"]
      },
      "then": {
        "properties": {"incomplete_reasons": {"minItems": 1}}
      }
    },
    {
      "if": {
        "properties": {"l4_tool_version_status": {"const": "not_run"}},
        "required": ["l4_tool_version_status"]
      },
      "then": {"properties": {"l4_tool_version": {"type": "null"}}}
    },
    {
      "if": {
        "properties": {"l4_tool_version_status": {"const": "not_captured"}},
        "required": ["l4_tool_version_status"]
      },
      "then": {"properties": {"l4_tool_version": {"type": "null"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "sha256", "size_bytes", "media_type"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
