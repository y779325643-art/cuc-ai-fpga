{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sr2fpga.local/contracts/evaluation/development-oracle-run-evidence/v1",
  "title": "SR2FPGA Development Oracle Run Evidence v1",
  "description": "Evaluator-local development evidence from the independent public oracle runner. It may contain raw simulator logs and is not terminal-selection, pass-credit, VPP, or official-hidden authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "evaluation_scope",
    "family_id",
    "bundle_sha256",
    "status",
    "failure_origin",
    "failure_type",
    "scenario_counts",
    "class_status",
    "scenario_results",
    "diagnostics",
    "pass_credit_authority",
    "official_outcome"
  ],
  "properties": {
    "contract_version": {"const": "development-oracle-run-evidence-v1"},
    "evaluation_scope": {"const": "development_independent_oracle"},
    "family_id": {"$ref": "#/$defs/identifier"},
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["passed", "failed"]},
    "failure_origin": {"$ref": "#/$defs/nullable_failure_origin"},
    "failure_type": {"$ref": "#/$defs/nullable_failure_type"},
    "scenario_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public_smoke": {"type": "integer", "minimum": 0},
        "hidden_deterministic": {"type": "integer", "minimum": 0},
        "randomized_fixed_seed": {"type": "integer", "minimum": 0},
        "stress": {"type": "integer", "minimum": 0}
      }
    },
    "class_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_smoke",
        "hidden_deterministic",
        "randomized_fixed_seed",
        "stress"
      ],
      "properties": {
        "public_smoke": {"$ref": "#/$defs/class_status"},
        "hidden_deterministic": {"$ref": "#/$defs/class_status"},
        "randomized_fixed_seed": {"$ref": "#/$defs/class_status"},
        "stress": {"$ref": "#/$defs/class_status"}
      }
    },
    "scenario_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/scenario_result"}
    },
    "diagnostics": {
      "type": "array",
      "items": {"type": "string"}
    },
    "pass_credit_authority": {"const": false},
    "official_outcome": {"const": false}
  },
  "allOf": [
    {"$ref": "#/$defs/execution_outcome_invariant"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "failure_origin": {
      "enum": [
        "natural_model_failure",
        "toolchain_environment_failure",
        "oracle_environment_failure"
      ]
    },
    "nullable_failure_origin": {
      "oneOf": [
        {"$ref": "#/$defs/failure_origin"},
        {"type": "null"}
      ]
    },
    "failure_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "nullable_failure_type": {
      "oneOf": [
        {"$ref": "#/$defs/failure_type"},
        {"type": "null"}
      ]
    },
    "class_status": {"enum": ["pass", "fail", "not_run"]},
    "execution_outcome_invariant": {
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "passed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "failure_origin": {"type": "null"},
              "failure_type": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "failed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "failure_origin": {"$ref": "#/$defs/failure_origin"},
              "failure_type": {"$ref": "#/$defs/failure_type"}
            }
          }
        }
      ]
    },
    "mismatch_detail": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "scenario_id": {"$ref": "#/$defs/identifier"},
        "class": {"type": ["string", "number", "integer", "boolean", "null"]},
        "item_index": {"type": ["string", "number", "integer", "boolean", "null"]},
        "expected": {"type": ["string", "number", "integer", "boolean", "null"]},
        "actual": {"type": ["string", "number", "integer", "boolean", "null"]},
        "signal": {"type": "string"},
        "cycle": {"type": "integer", "minimum": 0}
      }
    },
    "scenario_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "scenario_class",
        "status",
        "failure_origin",
        "failure_type",
        "command",
        "exit_code",
        "stdout",
        "stderr",
        "duration_seconds",
        "mismatch_detail"
      ],
      "properties": {
        "scenario_id": {"$ref": "#/$defs/identifier"},
        "scenario_class": {
          "enum": [
            "public_smoke",
            "hidden_deterministic",
            "randomized_fixed_seed",
            "stress"
          ]
        },
        "status": {"enum": ["passed", "failed"]},
        "failure_origin": {"$ref": "#/$defs/nullable_failure_origin"},
        "failure_type": {"$ref": "#/$defs/nullable_failure_type"},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "exit_code": {"type": ["integer", "null"]},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "duration_seconds": {"type": "number", "minimum": 0},
        "mismatch_detail": {
          "type": "array",
          "items": {"$ref": "#/$defs/mismatch_detail"}
        }
      },
      "allOf": [
        {"$ref": "#/$defs/execution_outcome_invariant"}
      ]
    }
  }
}
