{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sr2fpga.local/contracts/evaluation/development-episode-outcome/v1",
  "title": "SR2FPGA Development Episode Outcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "outcome_id", "evaluation_scope", "episode_id",
    "method_condition", "analysis_population", "public_evaluation_ref",
    "trajectory_ref", "terminal_candidate_ref", "cost_summary_refs",
    "development_hidden_outcome_ref", "lineage_complete", "all_cost_axes_classified",
    "stage_outcomes", "repair", "missingness", "vpp_l3_status", "vpp_l3",
    "vpp_l3_reasons", "denominator", "official_outcome", "rq1_evidence", "rq2_evidence"
  ],
  "properties": {
    "contract_version": {"const": "development-episode-outcome-v1"},
    "outcome_id": {"type": "string", "pattern": "^episode-outcome-[0-9a-f]{64}$"},
    "evaluation_scope": {"const": "excluded_development_conformance_only"},
    "episode_id": {"$ref": "#/$defs/identifier"},
    "method_condition": {"$ref": "#/$defs/method"},
    "analysis_population": {"const": "excluded"},
    "public_evaluation_ref": {"$ref": "#/$defs/artifact_ref"},
    "trajectory_ref": {"$ref": "#/$defs/artifact_ref"},
    "terminal_candidate_ref": {"$ref": "#/$defs/artifact_ref"},
    "cost_summary_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_ref"}},
    "development_hidden_outcome_ref": {"oneOf": [{"$ref": "#/$defs/hidden_ref"}, {"type": "null"}]},
    "development_hidden_conformance_outcome_ref": {"oneOf": [{"$ref": "#/$defs/artifact_ref"}, {"type": "null"}]},
    "lineage_complete": {"const": true},
    "all_cost_axes_classified": {"const": true},
    "stage_outcomes": {
      "type": "object", "additionalProperties": false,
      "required": ["generation", "h0", "h1", "h2", "h3", "l0", "l1", "public_l2", "l3"],
      "properties": {
        "generation": {"$ref": "#/$defs/stage"},
        "h0": {"$ref": "#/$defs/stage"},
        "h1": {"$ref": "#/$defs/stage"},
        "h2": {"$ref": "#/$defs/stage"},
        "h3": {"$ref": "#/$defs/stage"},
        "l0": {"$ref": "#/$defs/stage"},
        "l1": {"$ref": "#/$defs/stage"},
        "public_l2": {"$ref": "#/$defs/stage"},
        "l3": {"$ref": "#/$defs/stage"}
      }
    },
    "repair": {"$ref": "#/$defs/repair"},
    "missingness": {"$ref": "#/$defs/missingness"},
    "vpp_l3_status": {"const": "not_evaluated"},
    "vpp_l3": {"type": "null"},
    "vpp_l3_reasons": {
      "const": ["official_hidden_outcome_unavailable", "public_authority_not_official"]
    },
    "development_vpp_l3_status": {"enum": ["evaluated", "not_evaluated"]},
    "development_vpp_l3": {"type": ["boolean", "null"]},
    "development_vpp_l3_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]*$"}
    },
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "retained", "replacement_allowed"],
      "properties": {
        "population": {"const": "excluded"},
        "retained": {"const": true},
        "replacement_allowed": {"const": false}
      }
    },
    "official_outcome": {"const": false},
    "rq1_evidence": {"const": false},
    "rq2_evidence": {"const": false}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "method": {"enum": ["M0", "M1", "M2", "M3", "M4", "M5"]},
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "sha256", "size_bytes", "media_type"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "media_type": {"const": "application/json"}
      }
    },
    "hidden_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome_id", "contract_id"],
      "properties": {
        "outcome_id": {"type": "string", "pattern": "^hidden-outcome-[0-9a-f]{64}$"},
        "contract_id": {"const": "development-hidden-outcome-v1"}
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["pass", "fail", "not_run", "not_applicable"]},
        "reason": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      }
    },
    "repair_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["calls_attempted", "transitions"],
      "properties": {
        "calls_attempted": {"type": "integer", "minimum": 0},
        "transitions": {"type": "integer", "minimum": 0}
      }
    },
    "repair": {
      "type": "object", "additionalProperties": false,
      "required": [
        "reconciliation_status", "calls_attempted", "transitions", "successes",
        "diagnosis_count", "valid_patch_count", "rerun_count", "by_scope", "issues"
      ],
      "properties": {
        "reconciliation_status": {"const": "complete"},
        "calls_attempted": {"type": "integer", "minimum": 0},
        "transitions": {"type": "integer", "minimum": 0},
        "successes": {"type": "integer", "minimum": 0},
        "diagnosis_count": {"type": "integer", "minimum": 0},
        "valid_patch_count": {"type": "integer", "minimum": 0},
        "rerun_count": {"type": "integer", "minimum": 0},
        "by_scope": {
          "type": "object", "additionalProperties": false,
          "required": ["system_his", "project"],
          "properties": {
            "system_his": {"$ref": "#/$defs/repair_scope"},
            "project": {"$ref": "#/$defs/repair_scope"}
          }
        },
        "issues": {"maxItems": 0}
      }
    },
    "missingness": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "reason", "retained", "replacement_allowed"],
      "properties": {
        "classification": {"enum": ["scoreable_public_record", "design_outcome", "infrastructure_unscorable"]},
        "reason": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "retained": {"const": true},
        "replacement_allowed": {"const": false}
      }
    }
  }
}
