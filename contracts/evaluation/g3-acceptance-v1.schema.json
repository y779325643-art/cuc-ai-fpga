{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SR2FPGA G3 excluded development acceptance v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "evaluation_scope", "acceptance_id", "test_evidence_ref", "required_matrix_sha256", "matrix", "g3_accepted", "official_outcome", "official_authority", "pass_credit_authority", "g4b_authorized"],
  "properties": {
    "contract_version": {"const": "g3-acceptance-v1"},
    "evaluation_scope": {"const": "excluded_development_conformance_only"},
    "acceptance_id": {"type": "string", "pattern": "^g3-[0-9a-f]{64}$"},
    "test_evidence_ref": {"$ref": "#/$defs/artifact_ref"},
    "required_matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "matrix": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "test_node_ids", "status", "reasons", "source_artifacts"],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "test_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "status": {"enum": ["passed", "blocked"]},
        "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_artifacts": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["node_id", "store_id", "contract_key", "artifact_ref"],
          "properties": {
            "node_id": {"type": "string"}, "store_id": {"type": "string", "pattern": "^store-[0-9]{5}$"},
            "contract_key": {"type": "string", "minLength": 1}, "artifact_ref": {"$ref": "#/$defs/artifact_ref"}
          }
        }}
      }
    }},
    "g3_accepted": {"type": "boolean"},
    "official_outcome": {"const": false}, "official_authority": {"const": false},
    "pass_credit_authority": {"const": false}, "g4b_authorized": {"const": false}
  },
  "allOf": [{
    "if": {"properties": {"g3_accepted": {"const": true}}},
    "then": {"properties": {"matrix": {"items": {"properties": {
      "status": {"const": "passed"}, "reasons": {"maxItems": 0}, "test_node_ids": {"minItems": 1}
    }}}}}
  }],
  "$defs": {"artifact_ref": {
    "type": "object", "additionalProperties": false,
    "required": ["key", "sha256", "size_bytes", "media_type"],
    "properties": {
      "key": {"type": "string", "minLength": 1},
      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "size_bytes": {"type": "integer", "minimum": 0}, "media_type": {"type": "string", "minLength": 1}
    }
  }}
}
