        {
          "type": "object",
          "properties": {
            "param": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "param"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "add",
                "sub",
                "mul",
                "ceil_div",
                "min",
                "max"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/nat_expr"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "clog2"
