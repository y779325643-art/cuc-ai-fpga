        },
        "capability_profile": {
          "$ref": "#/$defs/content_ref"
        }
      },
      "required": [
        "requirements",
        "target_profile",
        "capability_profile"
      ],
      "additionalProperties": false,
      "description": "Controller-owned byte-hash bindings. The model emits only design. Schema alone does not authenticate ownership."
    },
    "nat_expr": {
      "description": "Bounded dimension expression, not HDL or Python. clog2(1)=0; zero widths are invalid after evaluation.",
