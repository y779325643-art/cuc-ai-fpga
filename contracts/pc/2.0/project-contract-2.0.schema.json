          "required": [
            "kind",
            "fields"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Fields are ordered, first field in least significant bits. Fixed-point means raw integer times 2^-fraction_bits, without implied rounding."
    },
    "reset": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "none"
            }
