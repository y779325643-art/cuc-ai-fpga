{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sr2fpga:pc:2.0",
  "title": "SR2FPGA Project Contract 2.0 — clean-slate design candidate",
  "description": "Breaking replacement proposal. Typed architecture plus trusted bindings; not a full HDL, approval receipt or correctness proof.",
