{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sr2fpga:pc21-development-capability:1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "limits"],
  "properties": {
    "contract_version": {"const": "pc21-development-capability-v1"},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_instances", "max_hierarchy_depth", "max_width", "max_tensor_elements", "supported_reset_kinds", "max_clock_domains"],
      "properties": {
        "max_instances": {"type": "integer", "minimum": 1, "maximum": 4096},
        "max_hierarchy_depth": {"type": "integer", "minimum": 1, "maximum": 64},
        "max_width": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_tensor_elements": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "supported_reset_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["none", "sync", "async"]}},
        "max_clock_domains": {"type": "integer", "minimum": 0, "maximum": 16}
      }
    }
  }
}
