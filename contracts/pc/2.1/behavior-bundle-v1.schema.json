{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sr2fpga:pc21-behavior-bundle:1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "build_plan_sha256", "units"],
  "properties": {
    "contract_version": {"const": "pc21-behavior-bundle-v1"},
    "build_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "units": {"type": "object", "additionalProperties": {
      "type": "object", "additionalProperties": false, "required": ["body"],
      "properties": {"body": {"type": "string", "minLength": 1}}
    }}
  }
}
