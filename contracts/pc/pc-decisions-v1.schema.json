{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sr2fpga.local/contracts/pc/pc-decisions-v1",
  "x-contract-version": "pc-decisions-v1",
  "title": "Model-owned PC decisions (host-owned version metadata)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "design_goal": {
              "type": "string",
              "minLength": 1
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "design_goal",
            "assumptions"
          ]
        },
        "top": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
            },
            "parameters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/parameter"
              }
            },
            "clocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/clock"
              }
            },
            "resets": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/reset"
              }
            },
            "ports": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/port"
              }
            },
            "interfaces": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/interface"
              }
            }
          },
          "required": [
            "name",
            "clocks",
            "resets",
            "ports"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/instance"
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/state_item"
              }
            },
            "counters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/state_item"
              }
            },
            "fsms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/state_item"
              }
            },
            "buffers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/state_item"
              }
            },
            "memories": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/state_item"
              }
            }
          },
          "required": [
            "registers",
            "counters",
            "fsms",
            "buffers",
            "memories"
          ]
        },
        "data_flow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flow"
          }
        },
        "control_flow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control"
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary_clock": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
            },
            "target_fmax_mhz": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "primary_clock",
            "target_fmax_mhz"
          ]
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "optimization_goal": {
              "type": "string",
              "minLength": 1
            },
            "expected": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lut": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "luts": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "ff": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "registers": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "bram": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "dsp": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "fmax_mhz": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              },
              "required": []
            }
          },
          "required": [
            "optimization_goal",
            "expected"
          ]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scenarios": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/scenario"
              }
            },
            "pass_condition": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "scenarios",
            "pass_condition"
          ]
        }
      },
      "required": [
        "intent",
        "top",
        "components",
        "instances",
        "state",
        "data_flow",
        "control_flow",
        "timing",
        "resources",
        "verification"
      ]
    },
    "fact_bindings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/binding"
        },
        "minItems": 1
      }
    }
  },
  "required": [
    "decisions",
    "fact_bindings"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
    },
    "str": {
      "type": "string",
      "minLength": 1
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      },
      "required": [
        "name",
        "default"
      ]
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
        },
        "dir": {
          "enum": [
            "input",
            "output",
            "inout"
          ]
        },
        "width": {
          "type": [
            "integer",
            "string"
          ]
        },
        "signed": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "dir",
        "width"
      ]
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
        },
        "target_fmax_mhz": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "name",
        "target_fmax_mhz"
      ]
    },
    "reset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
        },
        "polarity": {
          "enum": [
            "active_low",
            "active_high"
          ]
        },
        "kind": {
          "enum": [
            "sync",
            "async"
          ]
        }
      },
      "required": [
        "name",
        "polarity",
        "kind"
      ]
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generation": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "lanes": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      },
      "required": [
        "name",
        "protocol"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
        },
        "semantic_kind": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "combinational": {
          "type": "boolean"
        },
        "numeric_representation": {
          "type": "string",
          "minLength": 1
        },
        "latency_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "cdc_policy": {
          "type": "string",
          "minLength": 1
        },
        "burst_length": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "name",
        "semantic_kind",
        "source",
        "parameters",
        "ports",
        "intent",
        "combinational"
      ]
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
        },
        "component": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
        },
        "clock": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
        },
        "reset": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
        },
        "parameter_values": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "required": [
        "name",
        "component",
        "clock",
        "reset",
        "parameter_values"
      ]
    },
    "state_item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
        },
        "width": {
          "type": [
            "integer",
            "string"
          ]
        },
        "depth": {
          "type": [
            "integer",
            "string"
          ]
        },
        "read_latency": {
          "type": "integer",
          "minimum": 0
        },
        "read_type": {
          "type": "string",
          "minLength": 1
        },
        "memory_style": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "type": "string",
          "minLength": 1
        },
        "reset_value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "initial": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "reset_state": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "condition": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "from",
              "to"
            ]
          }
        },
        "signed": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "owner"
      ]
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "required": [
        "from",
        "to",
        "width"
      ]
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
            },
            "width": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "required": [
            "name",
            "width"
          ]
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connection"
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "latency_cycles": {
              "type": "integer",
              "minimum": 0
            },
            "throughput": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "required": []
        },
        "cdc": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "path",
        "protocol"
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "related_state": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "related_flows": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "name",
        "kind",
        "condition",
        "effects",
        "related_state",
        "related_flows"
      ]
    },
    "scenario": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "related_state": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "related_flows": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "signals": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "name"
          ]
        }
      ]
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "collection": {
              "enum": [
                "top.ports",
                "top.parameters",
                "top.clocks",
                "top.resets",
                "top.interfaces",
                "components",
                "instances",
                "state.registers",
                "state.counters",
                "state.fsms",
                "state.buffers",
                "state.memories",
                "data_flow",
                "control_flow"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "collection",
            "name",
            "path"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "collection": {
              "enum": [
                "intent",
                "top",
                "timing",
                "resources",
                "verification"
              ]
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "collection",
            "path"
          ]
        }
      ]
    }
  }
}
