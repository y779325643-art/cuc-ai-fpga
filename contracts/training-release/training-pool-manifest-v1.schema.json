{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sr2fpga.local/contracts/training-pool-manifest/v1",
  "title": "SR2FPGA candidate training pool manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "artifact_sha256",
    "visibility_class",
    "pool_id",
    "policy_id",
    "policy_sha256",
    "training_split_id",
    "e_final_episode_ids",
    "e_final_set_sha256",
    "e_traj_episode_ids",
    "e_traj_set_sha256",
    "treatment_rows",
    "mixture_strata"
  ],
  "properties": {
    "contract_version": {"const": "training-pool-manifest-v1"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "visibility_class": {"const": "release_internal"},
    "pool_id": {"$ref": "#/$defs/identifier"},
    "policy_id": {"$ref": "#/$defs/identifier"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "training_split_id": {"$ref": "#/$defs/identifier"},
    "e_final_episode_ids": {"$ref": "#/$defs/non_empty_episode_ids"},
    "e_final_set_sha256": {"$ref": "#/$defs/sha256"},
    "e_traj_episode_ids": {"$ref": "#/$defs/episode_ids"},
    "e_traj_set_sha256": {"$ref": "#/$defs/sha256"},
    "treatment_rows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["M6U", "M6F", "M6T", "M6F_E_TRAJ"],
      "properties": {
        "M6U": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row_ref"}},
        "M6F": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row_ref"}},
        "M6T": {"type": "array", "items": {"$ref": "#/$defs/row_ref"}},
        "M6F_E_TRAJ": {"type": "array", "items": {"$ref": "#/$defs/row_ref"}}
      }
    },
    "mixture_strata": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/mixture_stratum"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "episode_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "non_empty_episode_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "row_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_episode_id",
        "treatment",
        "row_id",
        "row_sha256",
        "sidecar_artifact_sha256",
        "eligibility_artifact_sha256"
      ],
      "properties": {
        "source_episode_id": {"$ref": "#/$defs/identifier"},
        "treatment": {"enum": ["M6U", "M6F", "M6T", "M6F_E_TRAJ"]},
        "row_id": {"$ref": "#/$defs/identifier"},
        "row_sha256": {"$ref": "#/$defs/sha256"},
        "sidecar_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "eligibility_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "transition_evidence_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"treatment": {"enum": ["M6T", "M6F_E_TRAJ"]}}},
          "then": {"required": ["transition_evidence_sha256"]},
          "else": {"not": {"required": ["transition_evidence_sha256"]}}
        }
      ]
    },
    "mixture_stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "source_class",
        "failure_origin",
        "episode_ids",
        "episode_count"
      ],
      "properties": {
        "family_id": {"$ref": "#/$defs/identifier"},
        "source_class": {"$ref": "#/$defs/identifier"},
        "failure_origin": {"$ref": "#/$defs/identifier"},
        "episode_ids": {"$ref": "#/$defs/non_empty_episode_ids"},
        "episode_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
