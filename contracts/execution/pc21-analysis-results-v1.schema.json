{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sr2fpga:pc21-analysis-results-v1",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "pc21-analysis-results-v1"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "family_id": {
            "enum": [
              "llm_quantized_qkv_projection",
              "llm_kv_cache_decode_attention",
              "llm_gated_ffn"
            ]
          },
          "design_cluster_id": {
            "type": "string",
            "minLength": 1
          },
          "dependency_group_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "semantic_instance_id": {
            "type": "string",
            "minLength": 1
          },
          "replicate_id": {
            "type": "string",
            "minLength": 1
          },
          "method_condition": {
            "enum": [
              "M0",
              "M1",
              "M2",
              "M3",
              "M4",
              "M5"
            ]
          },
          "endpoint": {
            "enum": [
              "initial",
              "B4"
            ]
          },
          "task_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "suite_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "configuration_weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "value": {
            "enum": [
              0,
              1,
              null
            ]
          },
          "outcome_class": {
            "enum": [
              "design_outcome",
              "infrastructure_unscorable",
              "not_applicable"
            ]
          },
          "budget_status": {
            "enum": [
              "compliant",
              "exceeded",
              "unverifiable"
            ]
          },
          "integrity_status": {
            "enum": [
              "intact",
              "violation",
              "unverifiable"
            ]
          },
          "candidate_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "slot_id",
          "task_sha256",
          "suite_sha256",
          "value",
          "outcome_class",
          "budget_status",
          "integrity_status",
          "candidate_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "contract_version",
    "results"
  ],
  "additionalProperties": false
}
