    {"if": {"properties": {"event_kind": {"const": "checkpoint_failed"}}}, "then": {"properties": {"status": {"const": "failed"}, "reason": {"type": "string", "minLength": 1}, "budget_reservation": {"type": "null"}, "cost_delta": {"$ref": "#/$defs/zero_cost_delta"}}}},
    {"if": {"properties": {"event_kind": {"const": "checkpoint_not_run"}}}, "then": {"properties": {"status": {"const": "not_run"}, "reason": {"type": "string", "minLength": 1}, "budget_reservation": {"type": "null"}, "cost_delta": {"$ref": "#/$defs/zero_cost_delta"}}}},
    {"if": {"properties": {"event_kind": {"const": "accounting_closed"}}}, "then": {"properties": {"checkpoint_id": {"type": "null"}, "parent_checkpoint_ids": {"const": []}, "stage": {"const": "accounting_close"}, "status": {"const": "closed"}, "budget_reservation": {"type": "null"}, "cost_delta": {"$ref": "#/$defs/full_cost_delta"}}}},
    {"if": {"properties": {"event_kind": {"not": {"const": "accounting_closed"}}}}, "then": {"properties": {"checkpoint_id": {"$ref": "#/$defs/checkpoint_id"}}}},
    {"if": {"properties": {"cost_delta": {"required": ["logical_model_calls"], "properties": {"logical_model_calls": {"type": "null"}}}}}, "then": {"properties": {"unavailable_axes": {"required": ["logical_model_calls"]}}}},
    {"if": {"properties": {"cost_delta": {"required": ["input_tokens"], "properties": {"input_tokens": {"type": "null"}}}}}, "then": {"properties": {"unavailable_axes": {"required": ["input_tokens"]}}}},
    {"if": {"properties": {"cost_delta": {"required": ["output_tokens"], "properties": {"output_tokens": {"type": "null"}}}}}, "then": {"properties": {"unavailable_axes": {"required": ["output_tokens"]}}}},
    {"if": {"properties": {"cost_delta": {"required": ["cached_tokens"], "properties": {"cached_tokens": {"type": "null"}}}}}, "then": {"properties": {"unavailable_axes": {"required": ["cached_tokens"]}}}},
    {"if": {"properties": {"cost_delta": {"required": ["provider_transport_attempts"], "properties": {"provider_transport_attempts": {"type": "null"}}}}}, "then": {"properties": {"unavailable_axes": {"required": ["provider_transport_attempts"]}}}},
    {"if": {"properties": {"cost_delta": {"required": ["planner_parser_schema_retries"], "properties": {"planner_parser_schema_retries": {"type": "null"}}}}}, "then": {"properties": {"unavailable_axes": {"required": ["planner_parser_schema_retries"]}}}},
