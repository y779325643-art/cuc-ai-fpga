  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint_id": {"enum": ["direct_initial_project", "shared_system_his", "skeleton_initial_project"]},
    "artifact_ref": {"type": "object", "additionalProperties": false, "required": ["key", "sha256", "size_bytes", "media_type"], "properties": {"key": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}, "media_type": {"type": "string", "minLength": 1}}},
    "failure_origin": {"oneOf": [{"enum": ["natural_llm", "synthetic_injected", "deterministic", "deterministic_template", "compositional_assembly"]}, {"type": "null"}]},
    "axis": {"enum": ["logical_model_calls", "input_tokens", "output_tokens", "cached_tokens", "provider_transport_attempts", "planner_parser_schema_retries", "outer_repair_attempts", "public_tool_calls", "hidden_evaluator_tool_calls", "hidden_infrastructure_retries", "wall_time", "eda_time", "hidden_evaluator_runtime"]},
    "nullable_count": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "nullable_duration": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "cost_delta": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"logical_model_calls": {"$ref": "#/$defs/nullable_count"}, "input_tokens": {"$ref": "#/$defs/nullable_count"}, "output_tokens": {"$ref": "#/$defs/nullable_count"}, "cached_tokens": {"$ref": "#/$defs/nullable_count"}, "provider_transport_attempts": {"$ref": "#/$defs/nullable_count"}, "planner_parser_schema_retries": {"$ref": "#/$defs/nullable_count"}, "outer_repair_attempts": {"$ref": "#/$defs/nullable_count"}, "public_tool_calls": {"$ref": "#/$defs/nullable_count"}, "hidden_evaluator_tool_calls": {"$ref": "#/$defs/nullable_count"}, "hidden_infrastructure_retries": {"$ref": "#/$defs/nullable_count"}, "wall_time": {"$ref": "#/$defs/nullable_duration"}, "eda_time": {"$ref": "#/$defs/nullable_duration"}, "hidden_evaluator_runtime": {"$ref": "#/$defs/nullable_duration"}}},
    "full_cost_delta": {"allOf": [{"$ref": "#/$defs/cost_delta"}, {"required": ["logical_model_calls", "input_tokens", "output_tokens", "cached_tokens", "provider_transport_attempts", "planner_parser_schema_retries", "outer_repair_attempts", "public_tool_calls", "hidden_evaluator_tool_calls", "hidden_infrastructure_retries", "wall_time", "eda_time", "hidden_evaluator_runtime"]}]},
    "zero_cost_delta": {"type": "object", "additionalProperties": false, "required": ["logical_model_calls", "input_tokens", "output_tokens", "cached_tokens", "provider_transport_attempts", "planner_parser_schema_retries", "outer_repair_attempts", "public_tool_calls", "hidden_evaluator_tool_calls", "hidden_infrastructure_retries", "wall_time", "eda_time", "hidden_evaluator_runtime"], "properties": {"logical_model_calls": {"const": 0}, "input_tokens": {"const": 0}, "output_tokens": {"const": 0}, "cached_tokens": {"const": 0}, "provider_transport_attempts": {"const": 0}, "planner_parser_schema_retries": {"const": 0}, "outer_repair_attempts": {"const": 0}, "public_tool_calls": {"const": 0}, "hidden_evaluator_tool_calls": {"const": 0}, "hidden_infrastructure_retries": {"const": 0}, "wall_time": {"const": 0}, "eda_time": {"const": 0}, "hidden_evaluator_runtime": {"const": 0}}},
    "unavailable_axes": {"type": "object", "additionalProperties": false, "properties": {"logical_model_calls": {"type": "string", "minLength": 1}, "input_tokens": {"type": "string", "minLength": 1}, "output_tokens": {"type": "string", "minLength": 1}, "cached_tokens": {"type": "string", "minLength": 1}, "provider_transport_attempts": {"type": "string", "minLength": 1}, "planner_parser_schema_retries": {"type": "string", "minLength": 1}, "outer_repair_attempts": {"type": "string", "minLength": 1}, "public_tool_calls": {"type": "string", "minLength": 1}, "hidden_evaluator_tool_calls": {"type": "string", "minLength": 1}, "hidden_infrastructure_retries": {"type": "string", "minLength": 1}, "wall_time": {"type": "string", "minLength": 1}, "eda_time": {"type": "string", "minLength": 1}, "hidden_evaluator_runtime": {"type": "string", "minLength": 1}}},
    "budget_reservation": {"type": "object", "additionalProperties": false, "required": ["axis", "amount", "limit", "used_after"], "properties": {"axis": {"$ref": "#/$defs/axis"}, "amount": {"type": "number", "exclusiveMinimum": 0}, "limit": {"type": "number", "minimum": 0}, "used_after": {"type": "number", "minimum": 0}}}
  }
