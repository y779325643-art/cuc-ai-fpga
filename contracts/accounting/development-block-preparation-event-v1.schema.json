    {"if": {"properties": {"checkpoint_id": {"const": "shared_system_his"}}}, "then": {"properties": {"parent_checkpoint_ids": {"const": []}, "stage": {"const": "block_req2his"}}}},
    {"if": {"properties": {"checkpoint_id": {"const": "skeleton_initial_project"}}}, "then": {"properties": {"parent_checkpoint_ids": {"const": ["shared_system_his"]}, "stage": {"const": "block_skeleton_initial"}}}},
    {"if": {"properties": {"event_kind": {"const": "budget_reserved"}}}, "then": {"properties": {"status": {"const": "reserved"}, "budget_reservation": {"$ref": "#/$defs/budget_reservation"}}}},
    {"if": {"properties": {"event_kind": {"const": "budget_exhausted"}}}, "then": {"properties": {"status": {"const": "exhausted"}, "budget_reservation": {"$ref": "#/$defs/budget_reservation"}}}},
