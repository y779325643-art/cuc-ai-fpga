{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sr2fpga.local/contracts/accounting/development-block-preparation-event/v1",
  "title": "SR2FPGA Development Block Preparation Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "evaluation_scope", "event_id", "parent_event_id", "sequence",
    "paired_block_ref", "checkpoint_id", "parent_checkpoint_ids", "stage", "event_kind",
    "status", "reason", "started_at", "duration_seconds", "input_artifact_refs",
    "output_artifact_refs", "input_artifact_hashes", "output_artifact_hashes",
    "budget_reservation", "cost_delta", "unavailable_axes", "model_gateway_provenance_ref",
    "failure_origin", "official_outcome", "official_authority", "pass_credit_authority",
    "rq1_evidence", "rq2_evidence", "g3_accepted", "g4b_authorized"
  ],
  "properties": {
    "contract_version": {"const": "development-block-preparation-event-v1"},
    "evaluation_scope": {"const": "excluded_development_conformance_only"},
    "event_id": {"type": "string", "pattern": "^block-preparation-event-[0-9a-f]{64}$"},
    "parent_event_id": {"oneOf": [{"type": "string", "pattern": "^block-preparation-event-[0-9a-f]{64}$"}, {"type": "null"}]},
    "sequence": {"type": "integer", "minimum": 0},
    "paired_block_ref": {"$ref": "#/$defs/artifact_ref"},
