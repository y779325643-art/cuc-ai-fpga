    {"if": {"properties": {"cost_delta": {"required": ["public_tool_calls"], "properties": {"public_tool_calls": {"type": "null"}}}}}, "then": {"properties": {"unavailable_axes": {"required": ["public_tool_calls"]}}}},
    {"if": {"properties": {"cost_delta": {"required": ["hidden_evaluator_tool_calls"], "properties": {"hidden_evaluator_tool_calls": {"type": "null"}}}}}, "then": {"properties": {"unavailable_axes": {"required": ["hidden_evaluator_tool_calls"]}}}},
    {"if": {"properties": {"cost_delta": {"required": ["hidden_infrastructure_retries"], "properties": {"hidden_infrastructure_retries": {"type": "null"}}}}}, "then": {"properties": {"unavailable_axes": {"required": ["hidden_infrastructure_retries"]}}}},
    {"if": {"properties": {"cost_delta": {"required": ["wall_time"], "properties": {"wall_time": {"type": "null"}}}}}, "then": {"properties": {"unavailable_axes": {"required": ["wall_time"]}}}},
    {"if": {"properties": {"cost_delta": {"required": ["eda_time"], "properties": {"eda_time": {"type": "null"}}}}}, "then": {"properties": {"unavailable_axes": {"required": ["eda_time"]}}}},
    {"if": {"properties": {"cost_delta": {"required": ["hidden_evaluator_runtime"], "properties": {"hidden_evaluator_runtime": {"type": "null"}}}}}, "then": {"properties": {"unavailable_axes": {"required": ["hidden_evaluator_runtime"]}}}}
    ,{"if": {"properties": {"unavailable_axes": {"required": ["logical_model_calls"]}}}, "then": {"properties": {"cost_delta": {"required": ["logical_model_calls"], "properties": {"logical_model_calls": {"type": "null"}}}}}}
    ,{"if": {"properties": {"unavailable_axes": {"required": ["input_tokens"]}}}, "then": {"properties": {"cost_delta": {"required": ["input_tokens"], "properties": {"input_tokens": {"type": "null"}}}}}}
    ,{"if": {"properties": {"unavailable_axes": {"required": ["output_tokens"]}}}, "then": {"properties": {"cost_delta": {"required": ["output_tokens"], "properties": {"output_tokens": {"type": "null"}}}}}}
    ,{"if": {"properties": {"unavailable_axes": {"required": ["cached_tokens"]}}}, "then": {"properties": {"cost_delta": {"required": ["cached_tokens"], "properties": {"cached_tokens": {"type": "null"}}}}}}
