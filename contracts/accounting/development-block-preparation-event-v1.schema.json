    ,{"if": {"properties": {"unavailable_axes": {"required": ["hidden_evaluator_tool_calls"]}}}, "then": {"properties": {"cost_delta": {"required": ["hidden_evaluator_tool_calls"], "properties": {"hidden_evaluator_tool_calls": {"type": "null"}}}}}}
    ,{"if": {"properties": {"unavailable_axes": {"required": ["hidden_infrastructure_retries"]}}}, "then": {"properties": {"cost_delta": {"required": ["hidden_infrastructure_retries"], "properties": {"hidden_infrastructure_retries": {"type": "null"}}}}}}
    ,{"if": {"properties": {"unavailable_axes": {"required": ["wall_time"]}}}, "then": {"properties": {"cost_delta": {"required": ["wall_time"], "properties": {"wall_time": {"type": "null"}}}}}}
    ,{"if": {"properties": {"unavailable_axes": {"required": ["eda_time"]}}}, "then": {"properties": {"cost_delta": {"required": ["eda_time"], "properties": {"eda_time": {"type": "null"}}}}}}
    ,{"if": {"properties": {"unavailable_axes": {"required": ["hidden_evaluator_runtime"]}}}, "then": {"properties": {"cost_delta": {"required": ["hidden_evaluator_runtime"], "properties": {"hidden_evaluator_runtime": {"type": "null"}}}}}}
