    ,{"if": {"properties": {"unavailable_axes": {"required": ["outer_repair_attempts"]}}}, "then": {"properties": {"cost_delta": {"required": ["outer_repair_attempts"], "properties": {"outer_repair_attempts": {"type": "null"}}}}}}
