    "output_artifact_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/artifact_ref"}},
    "input_artifact_hashes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "output_artifact_hashes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "budget_reservation": {"oneOf": [{"$ref": "#/$defs/budget_reservation"}, {"type": "null"}]},
    "cost_delta": {"$ref": "#/$defs/cost_delta"},
    "unavailable_axes": {"$ref": "#/$defs/unavailable_axes"},
