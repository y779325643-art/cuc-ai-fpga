    "parent_checkpoint_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/checkpoint_id"}},
    "stage": {"enum": ["block_direct_initial", "block_req2his", "block_skeleton_initial", "accounting_close"]},
