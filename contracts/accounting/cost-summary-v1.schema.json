{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sr2fpga.local/contracts/accounting/cost-summary/v1",
  "title": "SR2FPGA Cost Summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "episode_id", "attempt_id", "method_condition",
    "source_event_ids", "source_events_sha256", "event_count", "failure_count",
    "budget_exhaustion_count", "accounting_closed",
    "all_required_axes_reconciled", "axes"
  ],
  "properties": {
    "contract_version": {"const": "cost-summary-v1"},
    "episode_id": {"$ref": "#/$defs/identifier"},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "method_condition": {"enum": ["M0", "M1", "M2", "M3", "M4", "M5"]},
    "source_event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^attempt-event-[0-9a-f]{64}$"}
    },
    "source_events_sha256": {"$ref": "#/$defs/sha256"},
    "event_count": {"type": "integer", "minimum": 1},
    "failure_count": {"type": "integer", "minimum": 0},
    "budget_exhaustion_count": {"type": "integer", "minimum": 0},
    "accounting_closed": {"const": true},
    "all_required_axes_reconciled": {"type": "boolean"},
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_model_calls", "input_tokens", "output_tokens", "cached_tokens",
        "provider_transport_attempts", "planner_parser_schema_retries",
        "outer_repair_attempts", "public_tool_calls",
        "hidden_evaluator_tool_calls", "hidden_infrastructure_retries",
        "wall_time", "eda_time", "hidden_evaluator_runtime"
      ],
      "properties": {
        "logical_model_calls": {"$ref": "#/$defs/axis_result"},
        "input_tokens": {"$ref": "#/$defs/axis_result"},
        "output_tokens": {"$ref": "#/$defs/axis_result"},
        "cached_tokens": {"$ref": "#/$defs/axis_result"},
        "provider_transport_attempts": {"$ref": "#/$defs/axis_result"},
        "planner_parser_schema_retries": {"$ref": "#/$defs/axis_result"},
        "outer_repair_attempts": {"$ref": "#/$defs/axis_result"},
        "public_tool_calls": {"$ref": "#/$defs/axis_result"},
        "hidden_evaluator_tool_calls": {"$ref": "#/$defs/axis_result"},
        "hidden_infrastructure_retries": {"$ref": "#/$defs/axis_result"},
        "wall_time": {"$ref": "#/$defs/axis_result"},
        "eda_time": {"$ref": "#/$defs/axis_result"},
        "hidden_evaluator_runtime": {"$ref": "#/$defs/axis_result"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"all_required_axes_reconciled": {"const": true}}
      },
      "then": {
        "properties": {
          "axes": {
            "properties": {
              "logical_model_calls": {"$ref": "#/$defs/measured_axis"},
              "input_tokens": {"$ref": "#/$defs/measured_axis"},
              "output_tokens": {"$ref": "#/$defs/measured_axis"},
              "cached_tokens": {"$ref": "#/$defs/measured_axis"},
              "provider_transport_attempts": {"$ref": "#/$defs/measured_axis"},
              "planner_parser_schema_retries": {"$ref": "#/$defs/measured_axis"},
              "outer_repair_attempts": {"$ref": "#/$defs/measured_axis"},
              "public_tool_calls": {"$ref": "#/$defs/measured_axis"},
              "hidden_evaluator_tool_calls": {"$ref": "#/$defs/measured_axis"},
              "hidden_infrastructure_retries": {"$ref": "#/$defs/measured_axis"},
              "wall_time": {"$ref": "#/$defs/measured_axis"},
              "eda_time": {"$ref": "#/$defs/measured_axis"},
              "hidden_evaluator_runtime": {"$ref": "#/$defs/measured_axis"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "measured_axis": {
      "type": "object",
      "properties": {"status": {"const": "measured"}}
    },
    "axis_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "reason"],
      "properties": {
        "status": {"enum": ["measured", "unavailable"]},
        "value": {
          "oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]
        },
        "reason": {
          "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "measured"}}},
          "then": {
            "properties": {
              "value": {"type": "number", "minimum": 0},
              "reason": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "value": {"type": "null"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    }
  }
}
