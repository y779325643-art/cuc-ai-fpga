{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sr2fpga.local/contracts/public-evaluation-candidate/v1",
  "title": "SR2FPGA Public Evaluation Candidate v1",
  "description": "Immutable per-attempt project snapshot sealed before public evaluation. It is neither a terminal selection nor a pass-credit outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "candidate_id", "episode_id", "attempt_id",
    "method_condition_id", "seal_stage", "terminal_status",
    "pass_credit_authority", "project_name", "project_envelope_ref",
    "requirement_projection_sha256", "creation_event_ref", "project_files"
  ],
  "properties": {
    "contract_version": {"const": "public-evaluation-candidate-v1"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "episode_id": {"$ref": "#/$defs/identifier"},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "method_condition_id": {"enum": ["M0", "M1", "M2", "M3", "M4", "M5"]},
    "seal_stage": {"const": "pre_public_evaluation"},
    "terminal_status": {"const": "unselected_at_seal"},
    "pass_credit_authority": {"const": false},
    "project_name": {"$ref": "#/$defs/identifier"},
    "project_envelope_ref": {"$ref": "#/$defs/artifact_ref"},
    "requirement_projection_sha256": {"$ref": "#/$defs/sha256"},
    "creation_event_ref": {"$ref": "#/$defs/event_artifact_ref"},
    "project_files": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/file_ref"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_key", "sha256", "size_bytes", "media_type"],
      "properties": {
        "artifact_key": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "event_artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_key", "sha256", "size_bytes", "media_type", "event_id"],
      "properties": {
        "artifact_key": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "media_type": {"type": "string", "minLength": 1},
        "event_id": {"type": "string", "pattern": "^event-[0-9a-f]{64}$"}
      }
    },
    "file_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "artifact_key", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "artifact_key": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
