{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sr2fpga.local/contracts/requirement-audit/ambiguity-witness/v1",
  "title": "SR2FPGA evaluator-only ambiguity witness and adjudication v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "artifact_sha256",
    "audit_run_id",
    "manifest_sha256",
    "visibility_class",
    "private_canary",
    "cases"
  ],
  "properties": {
    "contract_version": {"const": "ambiguity-witness-v1"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "audit_run_id": {"$ref": "#/$defs/identifier"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "visibility_class": {"const": "evaluator_only"},
    "private_canary": {"type": "string", "minLength": 16},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case_witness"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "annotation_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitment_id", "annotation_sha256"],
      "properties": {
        "commitment_id": {"$ref": "#/$defs/identifier"},
        "annotation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "adjudicator_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitment_id", "adjudication_sha256", "status"],
      "properties": {
        "commitment_id": {"$ref": "#/$defs/identifier"},
        "adjudication_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "adjudicated"}
      }
    },
    "interpretation_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "witness_id",
        "interpretation_sha256",
        "observable_consequence_ids",
        "support_status"
      ],
      "properties": {
        "witness_id": {"$ref": "#/$defs/identifier"},
        "interpretation_sha256": {"$ref": "#/$defs/sha256"},
        "observable_consequence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "support_status": {"enum": ["supported", "unsupported", "unknown"]}
      }
    },
    "case_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_requirement_cluster_id",
        "ambiguity_case_id",
        "expected_disposition",
        "adjudication_basis",
        "fact_graph_sha256",
        "capability_rationale_sha256",
        "critical_fact_ids",
        "capability_ids",
        "permitted_default_ids",
        "explicit_assumption_ids",
        "unknown_family_counterexample",
        "annotator_commitments",
        "adjudicator_commitment",
        "material_interpretation_witnesses"
      ],
      "properties": {
        "base_requirement_cluster_id": {"$ref": "#/$defs/identifier"},
        "ambiguity_case_id": {"$ref": "#/$defs/identifier"},
        "expected_disposition": {
          "enum": ["ready", "needs_clarification", "capability_gap"]
        },
        "adjudication_basis": {
          "enum": ["resolved_requirement", "material_interpretations", "explicit_contradiction"]
        },
        "fact_graph_sha256": {"$ref": "#/$defs/sha256"},
        "capability_rationale_sha256": {"$ref": "#/$defs/sha256"},
        "critical_fact_ids": {"$ref": "#/$defs/identifier_array"},
        "capability_ids": {"$ref": "#/$defs/identifier_array"},
        "permitted_default_ids": {"$ref": "#/$defs/identifier_array"},
        "explicit_assumption_ids": {"$ref": "#/$defs/identifier_array"},
        "unknown_family_counterexample": {"type": "boolean"},
        "annotator_commitments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/annotation_commitment"}
        },
        "adjudicator_commitment": {"$ref": "#/$defs/adjudicator_commitment"},
        "material_interpretation_witnesses": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/interpretation_witness"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"adjudication_basis": {"const": "material_interpretations"}}},
          "then": {"properties": {"material_interpretation_witnesses": {"minItems": 2}}}
        },
        {
          "if": {"properties": {"expected_disposition": {"const": "needs_clarification"}}},
          "then": {
            "properties": {
              "adjudication_basis": {
                "enum": ["material_interpretations", "explicit_contradiction"]
              },
              "critical_fact_ids": {"minItems": 1}
            }
          },
          "else": {"properties": {"adjudication_basis": {"const": "resolved_requirement"}}}
        },
        {
          "if": {"properties": {"expected_disposition": {"const": "capability_gap"}}},
          "then": {"properties": {"capability_ids": {"minItems": 1}}}
        }
      ]
    }
  }
}
