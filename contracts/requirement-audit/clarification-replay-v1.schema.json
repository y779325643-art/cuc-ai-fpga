{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sr2fpga.local/contracts/requirement-audit/clarification-replay/v1",
  "title": "SR2FPGA clarification replay artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "artifact_sha256",
    "audit_run_id",
    "manifest_sha256",
    "phase_a_audit_sha256",
    "visibility_class",
    "replays"
  ],
  "properties": {
    "contract_version": {"const": "clarification-replay-v1"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "audit_run_id": {"$ref": "#/$defs/identifier"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "phase_a_audit_sha256": {"$ref": "#/$defs/sha256"},
    "visibility_class": {"const": "evaluator_only"},
    "replays": {"type": "array", "items": {"$ref": "#/$defs/replay"}}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_disposition": {"enum": ["ready", "capability_gap"]},
    "actual_disposition": {
      "enum": ["ready", "needs_clarification", "capability_gap"]
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_calls",
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "cached_tokens",
        "wall_time_ms"
      ],
      "properties": {
        "model_calls": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cached_tokens": {"type": "integer", "minimum": 0},
        "wall_time_ms": {"type": "number", "minimum": 0}
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_requirement_cluster_id",
        "ambiguity_case_id",
        "branch_id",
        "phase_a_case_sha256",
        "answer_sha256",
        "lineage_sha256",
        "one_shot_marker_sha256",
        "replayed_fact_ids",
        "expected_replay_disposition",
        "actual_replay_disposition",
        "closure",
        "generation_boundary_crossed",
        "counters"
      ],
      "properties": {
        "base_requirement_cluster_id": {"$ref": "#/$defs/identifier"},
        "ambiguity_case_id": {"$ref": "#/$defs/identifier"},
        "branch_id": {"$ref": "#/$defs/identifier"},
        "phase_a_case_sha256": {"$ref": "#/$defs/sha256"},
        "answer_sha256": {"$ref": "#/$defs/sha256"},
        "lineage_sha256": {"$ref": "#/$defs/sha256"},
        "one_shot_marker_sha256": {"$ref": "#/$defs/sha256"},
        "replayed_fact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "expected_replay_disposition": {"$ref": "#/$defs/expected_disposition"},
        "actual_replay_disposition": {"$ref": "#/$defs/actual_disposition"},
        "closure": {"type": "boolean"},
        "generation_boundary_crossed": {"const": false},
        "counters": {"$ref": "#/$defs/counters"}
      }
    }
  }
}
