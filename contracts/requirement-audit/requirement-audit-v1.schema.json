{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sr2fpga.local/contracts/requirement-audit/v1",
  "title": "SR2FPGA Requirement Ambiguity Audit v1",
  "description": "Evaluator-owned case records and run summary for the Paper-1 RQ0/OASA requirement-boundary audit. The audit_sha256 is computed over the canonical artifact with audit_sha256 omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_version",
    "audit_sha256",
    "audit_run_id",
    "visibility_class",
    "cases",
    "summary"
  ],
  "properties": {
    "audit_version": {
      "const": "requirement-audit-v1"
    },
    "audit_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "audit_run_id": {
      "$ref": "#/$defs/identifier"
    },
    "visibility_class": {
      "const": "evaluator_only"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/audit_case"
      }
    },
    "summary": {
      "$ref": "#/$defs/run_summary"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "visibility_class": {
      "type": "string",
      "enum": [
        "generation_visible",
        "audit_only",
        "evaluator_only"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "ready",
        "needs_clarification",
        "capability_gap"
      ]
    },
    "identifier_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "fact_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "origin",
        "value"
      ],
      "properties": {
        "fact_id": {
          "$ref": "#/$defs/identifier"
        },
        "origin": {
          "type": "string",
          "enum": [
            "user_explicit",
            "platform_default",
            "system_assumption",
            "unresolved"
          ]
        },
        "value": {},
        "evidence_ids": {
          "$ref": "#/$defs/identifier_array"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "origin"
            ],
            "properties": {
              "origin": {
                "const": "unresolved"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "generation_visible_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility_class",
        "public_requirement",
        "public_requirement_sha256",
        "width_bits",
        "platform_profile_id",
        "platform_profile_sha256",
        "capability_profile_id",
        "capability_profile_sha256"
      ],
      "properties": {
        "visibility_class": {
          "const": "generation_visible"
        },
        "public_requirement": {
          "type": "string",
          "minLength": 1
        },
        "public_requirement_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "width_bits": {
          "type": "integer",
          "minimum": 1
        },
        "platform_profile_id": {
          "$ref": "#/$defs/identifier"
        },
        "platform_profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capability_profile_id": {
          "$ref": "#/$defs/identifier"
        },
        "capability_profile_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "envelope_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_version",
        "envelope_sha256",
        "requirement_id",
        "facts",
        "ambiguity_fact_ids",
        "capability_ids"
      ],
      "properties": {
        "envelope_version": {
          "$ref": "#/$defs/identifier"
        },
        "envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "requirement_id": {
          "$ref": "#/$defs/identifier"
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fact_record"
          }
        },
        "ambiguity_fact_ids": {
          "$ref": "#/$defs/identifier_array"
        },
        "capability_ids": {
          "$ref": "#/$defs/identifier_array"
        }
      }
    },
    "route_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_version",
        "route_sha256",
        "strategy_id",
        "reason_ids",
        "fact_ids",
        "capability_ids"
      ],
      "properties": {
        "route_version": {
          "$ref": "#/$defs/identifier"
        },
        "route_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "strategy_id": {
          "$ref": "#/$defs/identifier"
        },
        "reason_ids": {
          "$ref": "#/$defs/identifier_array"
        },
        "fact_ids": {
          "$ref": "#/$defs/identifier_array"
        },
        "capability_ids": {
          "$ref": "#/$defs/identifier_array"
        }
      }
    },
    "preflight_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility_class",
        "envelope",
        "route"
      ],
      "properties": {
        "visibility_class": {
          "const": "audit_only"
        },
        "envelope": {
          "$ref": "#/$defs/envelope_projection"
        },
        "route": {
          "$ref": "#/$defs/route_projection"
        }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_calls",
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "cached_tokens",
        "wall_time_ms"
      ],
      "properties": {
        "model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "wall_time_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "boundary_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility_class",
        "execution_status",
        "reason_ids",
        "fact_ids",
        "capability_ids",
        "generation_boundary_crossed",
        "counters"
      ],
      "properties": {
        "visibility_class": {
          "const": "audit_only"
        },
        "execution_status": {
          "type": "string",
          "enum": [
            "completed",
            "not_run"
          ]
        },
        "predicted_disposition": {
          "$ref": "#/$defs/disposition"
        },
        "not_run_reason_id": {
          "$ref": "#/$defs/identifier"
        },
        "reason_ids": {
          "$ref": "#/$defs/identifier_array"
        },
        "fact_ids": {
          "$ref": "#/$defs/identifier_array"
        },
        "capability_ids": {
          "$ref": "#/$defs/identifier_array"
        },
        "generation_boundary_crossed": {
          "type": "boolean"
        },
        "counters": {
          "$ref": "#/$defs/counters"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "execution_status"
            ],
            "properties": {
              "execution_status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "required": [
              "predicted_disposition"
            ],
            "not": {
              "required": [
                "not_run_reason_id"
              ]
            }
          },
          "else": {
            "required": [
              "not_run_reason_id"
            ],
            "not": {
              "required": [
                "predicted_disposition"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "predicted_disposition"
            ],
            "properties": {
              "predicted_disposition": {
                "const": "needs_clarification"
              }
            }
          },
          "then": {
            "properties": {
              "fact_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "predicted_disposition"
            ],
            "properties": {
              "predicted_disposition": {
                "const": "capability_gap"
              }
            }
          },
          "then": {
            "properties": {
              "capability_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "clarification_answer_branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_id",
        "visibility_class",
        "answer_sha256",
        "answer_facts",
        "expected_replay_disposition"
      ],
      "properties": {
        "branch_id": {
          "$ref": "#/$defs/identifier"
        },
        "visibility_class": {
          "const": "evaluator_only"
        },
        "answer_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "answer_facts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          }
        },
        "expected_replay_disposition": {
          "type": "string",
          "enum": [
            "ready",
            "capability_gap"
          ]
        }
      }
    },
    "evaluator_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility_class",
        "gold_disposition",
        "gold_reason_ids",
        "gold_fact_ids",
        "gold_capability_ids"
      ],
      "properties": {
        "visibility_class": {
          "const": "evaluator_only"
        },
        "gold_disposition": {
          "$ref": "#/$defs/disposition"
        },
        "gold_reason_ids": {
          "$ref": "#/$defs/identifier_array"
        },
        "gold_fact_ids": {
          "$ref": "#/$defs/identifier_array"
        },
        "gold_capability_ids": {
          "$ref": "#/$defs/identifier_array"
        },
        "clarification_answer_branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/clarification_answer_branch"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "gold_disposition"
            ],
            "properties": {
              "gold_disposition": {
                "const": "needs_clarification"
              }
            }
          },
          "then": {
            "required": [
              "clarification_answer_branches"
            ],
            "properties": {
              "gold_fact_ids": {
                "minItems": 1
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "clarification_answer_branches"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "gold_disposition"
            ],
            "properties": {
              "gold_disposition": {
                "const": "capability_gap"
              }
            }
          },
          "then": {
            "properties": {
              "gold_capability_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "audit_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_requirement_cluster_id",
        "ambiguity_case_id",
        "generation_visible_projection",
        "preflight_projection",
        "boundary_result",
        "evaluator_only"
      ],
      "properties": {
        "base_requirement_cluster_id": {
          "$ref": "#/$defs/identifier"
        },
        "ambiguity_case_id": {
          "$ref": "#/$defs/identifier"
        },
        "generation_visible_projection": {
          "$ref": "#/$defs/generation_visible_projection"
        },
        "preflight_projection": {
          "$ref": "#/$defs/preflight_projection"
        },
        "boundary_result": {
          "$ref": "#/$defs/boundary_result"
        },
        "evaluator_only": {
          "$ref": "#/$defs/evaluator_projection"
        }
      }
    },
    "disposition_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "needs_clarification",
        "capability_gap"
      ],
      "properties": {
        "ready": {
          "type": "integer",
          "minimum": 0
        },
        "needs_clarification": {
          "type": "integer",
          "minimum": 0
        },
        "capability_gap": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "run_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility_class",
        "case_count",
        "execution_status_counts",
        "predicted_disposition_counts",
        "gold_disposition_counts",
        "confusion_matrix",
        "generation_boundary_crossed_count",
        "false_proceed_count",
        "false_block_count",
        "counter_totals"
      ],
      "properties": {
        "visibility_class": {
          "const": "evaluator_only"
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "execution_status_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "completed",
            "not_run"
          ],
          "properties": {
            "completed": {
              "type": "integer",
              "minimum": 0
            },
            "not_run": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "predicted_disposition_counts": {
          "$ref": "#/$defs/disposition_counts"
        },
        "gold_disposition_counts": {
          "$ref": "#/$defs/disposition_counts"
        },
        "confusion_matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ready",
            "needs_clarification",
            "capability_gap"
          ],
          "properties": {
            "ready": {
              "$ref": "#/$defs/disposition_counts"
            },
            "needs_clarification": {
              "$ref": "#/$defs/disposition_counts"
            },
            "capability_gap": {
              "$ref": "#/$defs/disposition_counts"
            }
          }
        },
        "generation_boundary_crossed_count": {
          "type": "integer",
          "minimum": 0
        },
        "false_proceed_count": {
          "type": "integer",
          "minimum": 0
        },
        "false_block_count": {
          "type": "integer",
          "minimum": 0
        },
        "counter_totals": {
          "$ref": "#/$defs/counters"
        }
      }
    }
  }
}
