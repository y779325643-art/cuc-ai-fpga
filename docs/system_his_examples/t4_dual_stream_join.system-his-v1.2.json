{
  "schema_version": "system-his-v1.2",
  "intent": {
    "user_prompt": "Generate an 8-bit FPGA RTL project that joins two input streams, accumulates joined samples, and exposes one output stream.",
    "design_goal": "Buffer two valid-ready input streams, join aligned samples, accumulate joined values, and present the accumulated result through a staged valid-ready output.",
    "assumptions": [
      "Both input streams use the same clock and reset.",
      "Each joined sample is the sum of one sample from input stream 0 and one sample from input stream 1.",
      "The accumulator updates only when a joined sample is accepted by the downstream stage."
    ]
  },
  "top": {
    "name": "top",
    "parameters": [
      {"name": "DATA_WIDTH", "value": 8}
    ],
    "clocks": [
      {"name": "clk", "target_fmax_mhz": 100}
    ],
    "resets": [
      {"name": "rst_n", "polarity": "active_low", "kind": "sync"}
    ],
    "ports": [
      {"name": "clk", "dir": "input", "width": 1},
      {"name": "rst_n", "dir": "input", "width": 1},
      {"name": "in0_valid", "dir": "input", "width": 1},
      {"name": "in0_ready", "dir": "output", "width": 1},
      {"name": "in0_data", "dir": "input", "width": {"expr": "DATA_WIDTH", "resolved": 8}},
      {"name": "in1_valid", "dir": "input", "width": 1},
      {"name": "in1_ready", "dir": "output", "width": 1},
      {"name": "in1_data", "dir": "input", "width": {"expr": "DATA_WIDTH", "resolved": 8}},
      {"name": "out_valid", "dir": "output", "width": 1},
      {"name": "out_ready", "dir": "input", "width": 1},
      {"name": "out_data", "dir": "output", "width": {"expr": "DATA_WIDTH", "resolved": 8}}
    ],
    "interfaces": [
      {
        "name": "in0",
        "protocol": "valid_ready",
        "role": "sink",
        "signals": {
          "valid": "in0_valid",
          "ready": "in0_ready",
          "data": "in0_data"
        }
      },
      {
        "name": "in1",
        "protocol": "valid_ready",
        "role": "sink",
        "signals": {
          "valid": "in1_valid",
          "ready": "in1_ready",
          "data": "in1_data"
        }
      },
      {
        "name": "out",
        "protocol": "valid_ready",
        "role": "source",
        "signals": {
          "valid": "out_valid",
          "ready": "out_ready",
          "data": "out_data"
        }
      }
    ]
  },
  "state": {
    "registers": [
      {
        "name": "sum_q",
        "owner": "accumulator",
        "width": {"expr": "DATA_WIDTH", "resolved": 8},
        "reset_value": 0,
        "update_condition": "join_out_valid && join_out_ready",
        "intent": "running accumulated sum of accepted joined samples"
      },
      {
        "name": "out_valid_q",
        "owner": "out_stage",
        "width": 1,
        "reset_value": 0,
        "update_condition": "out_stage accepts or releases a sample",
        "intent": "valid bit for the output stage"
      },
      {
        "name": "out_data_q",
        "owner": "out_stage",
        "width": {"expr": "DATA_WIDTH", "resolved": 8},
        "reset_value": 0,
        "update_condition": "out_stage accepts a new accumulator value",
        "intent": "registered output payload"
      }
    ],
    "counters": [],
    "fsms": [
      {
        "name": "join_fsm",
        "owner": "join_core",
        "states": ["IDLE", "WAIT_BOTH", "FIRE"],
        "initial": "IDLE",
        "reset_state": "IDLE"
      }
    ],
    "buffers": [
      {
        "name": "in0_buffer_state",
        "owner": "in0_buffer",
        "kind": "skid_buffer",
        "depth": 1,
        "payload_width": {"expr": "DATA_WIDTH", "resolved": 8}
      },
      {
        "name": "in1_buffer_state",
        "owner": "in1_buffer",
        "kind": "skid_buffer",
        "depth": 1,
        "payload_width": {"expr": "DATA_WIDTH", "resolved": 8}
      }
    ],
    "memories": []
  },
  "components": [
    {
      "name": "skid_buffer",
      "semantic_kind": "stream_buffer",
      "source": "rtl/skid_buffer.v",
      "parameters": [
        {"name": "DATA_WIDTH", "default": 8}
      ],
      "ports": [
        {"name": "clk", "dir": "input", "width": 1},
        {"name": "rst_n", "dir": "input", "width": 1},
        {"name": "in_valid", "dir": "input", "width": 1},
        {"name": "in_ready", "dir": "output", "width": 1},
        {"name": "in_data", "dir": "input", "width": {"expr": "DATA_WIDTH", "resolved": 8}},
        {"name": "out_valid", "dir": "output", "width": 1},
        {"name": "out_ready", "dir": "input", "width": 1},
        {"name": "out_data", "dir": "output", "width": {"expr": "DATA_WIDTH", "resolved": 8}}
      ],
      "intent": "one-entry elastic buffer for valid-ready streams"
    },
    {
      "name": "stream_join",
      "semantic_kind": "stream_join",
      "source": "rtl/stream_join.v",
      "parameters": [
        {"name": "DATA_WIDTH", "default": 8}
      ],
      "ports": [
        {"name": "in0_valid", "dir": "input", "width": 1},
        {"name": "in0_ready", "dir": "output", "width": 1},
        {"name": "in0_data", "dir": "input", "width": {"expr": "DATA_WIDTH", "resolved": 8}},
        {"name": "in1_valid", "dir": "input", "width": 1},
        {"name": "in1_ready", "dir": "output", "width": 1},
        {"name": "in1_data", "dir": "input", "width": {"expr": "DATA_WIDTH", "resolved": 8}},
        {"name": "out_valid", "dir": "output", "width": 1},
        {"name": "out_ready", "dir": "input", "width": 1},
        {"name": "out_data", "dir": "output", "width": {"expr": "DATA_WIDTH", "resolved": 8}}
      ],
      "intent": "accept one sample from each input stream and produce one joined payload"
    },
    {
      "name": "accumulator_core",
      "semantic_kind": "accumulator",
      "source": "rtl/accumulator_core.v",
      "parameters": [
        {"name": "DATA_WIDTH", "default": 8}
      ],
      "ports": [
        {"name": "clk", "dir": "input", "width": 1},
        {"name": "rst_n", "dir": "input", "width": 1},
        {"name": "sample_valid", "dir": "input", "width": 1},
        {"name": "sample_ready", "dir": "output", "width": 1},
        {"name": "sample", "dir": "input", "width": {"expr": "DATA_WIDTH", "resolved": 8}},
        {"name": "sum_valid", "dir": "output", "width": 1},
        {"name": "sum_ready", "dir": "input", "width": 1},
        {"name": "sum", "dir": "output", "width": {"expr": "DATA_WIDTH", "resolved": 8}}
      ],
      "intent": "accumulate accepted joined samples"
    },
    {
      "name": "stream_stage",
      "semantic_kind": "output_stage",
      "source": "rtl/stream_stage.v",
      "parameters": [
        {"name": "DATA_WIDTH", "default": 8}
      ],
      "ports": [
        {"name": "clk", "dir": "input", "width": 1},
        {"name": "rst_n", "dir": "input", "width": 1},
        {"name": "in_valid", "dir": "input", "width": 1},
        {"name": "in_ready", "dir": "output", "width": 1},
        {"name": "in_data", "dir": "input", "width": {"expr": "DATA_WIDTH", "resolved": 8}},
        {"name": "out_valid", "dir": "output", "width": 1},
        {"name": "out_ready", "dir": "input", "width": 1},
        {"name": "out_data", "dir": "output", "width": {"expr": "DATA_WIDTH", "resolved": 8}}
      ],
      "intent": "registered output stage that holds data under backpressure"
    }
  ],
  "instances": [
    {
      "name": "in0_buffer",
      "component": "skid_buffer",
      "parameter_values": {"DATA_WIDTH": 8},
      "clock": "clk",
      "reset": "rst_n",
      "owns_state": ["in0_buffer_state"]
    },
    {
      "name": "in1_buffer",
      "component": "skid_buffer",
      "parameter_values": {"DATA_WIDTH": 8},
      "clock": "clk",
      "reset": "rst_n",
      "owns_state": ["in1_buffer_state"]
    },
    {
      "name": "join_core",
      "component": "stream_join",
      "parameter_values": {"DATA_WIDTH": 8},
      "clock": "clk",
      "reset": "rst_n",
      "owns_state": []
    },
    {
      "name": "accumulator",
      "component": "accumulator_core",
      "parameter_values": {"DATA_WIDTH": 8},
      "clock": "clk",
      "reset": "rst_n",
      "owns_state": ["sum_q"]
    },
    {
      "name": "out_stage",
      "component": "stream_stage",
      "parameter_values": {"DATA_WIDTH": 8},
      "clock": "clk",
      "reset": "rst_n",
      "owns_state": ["out_valid_q", "out_data_q"]
    }
  ],
  "data_flow": [
    {
      "name": "input0_payload_to_join",
      "path": ["top.in0_data", "in0_buffer.in_data", "in0_buffer.out_data", "join_core.in0_data"],
      "payload": {"name": "in0_sample", "width": {"expr": "DATA_WIDTH", "resolved": 8}},
      "protocol": "valid_ready",
      "timing": {"latency_cycles": 1, "initiation_interval": 1, "throughput": "one sample per cycle when both inputs are valid"}
    },
    {
      "name": "input1_payload_to_join",
      "path": ["top.in1_data", "in1_buffer.in_data", "in1_buffer.out_data", "join_core.in1_data"],
      "payload": {"name": "in1_sample", "width": {"expr": "DATA_WIDTH", "resolved": 8}},
      "protocol": "valid_ready",
      "timing": {"latency_cycles": 1, "initiation_interval": 1, "throughput": "one sample per cycle when both inputs are valid"}
    },
    {
      "name": "joined_payload_to_accumulator",
      "path": ["join_core.out_data", "accumulator.sample"],
      "payload": {"name": "joined_sample", "width": {"expr": "DATA_WIDTH", "resolved": 8}},
      "protocol": "valid_ready",
      "timing": {"latency_cycles": 0, "initiation_interval": 1, "throughput": "one joined sample per cycle"}
    },
    {
      "name": "accumulator_to_output",
      "path": ["accumulator.sum", "out_stage.in_data", "out_stage.out_data", "top.out_data"],
      "payload": {"name": "accumulated_sum", "width": {"expr": "DATA_WIDTH", "resolved": 8}},
      "protocol": "valid_ready",
      "timing": {"latency_cycles": 2, "initiation_interval": 1, "throughput": "one accumulated sample per cycle when output is ready"}
    }
  ],
  "control_flow": [
    {
      "name": "reset_all_state",
      "kind": "reset_rule",
      "condition": "rst_n == 0",
      "effects": [
        "clear in0_buffer_state",
        "clear in1_buffer_state",
        "sum_q := 0",
        "out_valid_q := 0",
        "out_data_q := 0"
      ],
      "related_state": ["in0_buffer_state", "in1_buffer_state", "sum_q", "out_valid_q", "out_data_q"],
      "related_flows": []
    },
    {
      "name": "join_fire",
      "kind": "handshake_rule",
      "when": {
        "all_of": [
          {"signal": "in0_buffer.out_valid", "op": "==", "value": 1},
          {"signal": "in1_buffer.out_valid", "op": "==", "value": 1},
          {"signal": "join_core.out_ready", "op": "==", "value": 1}
        ]
      },
      "effect": {"action": "transfer", "target": "joined_payload_to_accumulator"},
      "related_state": ["in0_buffer_state", "in1_buffer_state", "join_fsm.state"],
      "related_flows": ["input0_payload_to_join", "input1_payload_to_join", "joined_payload_to_accumulator"]
    },
    {
      "name": "join_wait_to_fire",
      "kind": "fsm_transition",
      "fsm": "join_fsm",
      "from": "WAIT_BOTH",
      "to": "FIRE",
      "when": {
        "all_of": [
          {"signal": "top.in0_valid", "op": "==", "value": 1},
          {"signal": "top.in1_valid", "op": "==", "value": 1}
        ]
      },
      "effect": {"action": "assert", "target": "joined_payload_to_accumulator"},
      "related_state": ["join_fsm.state"],
      "related_flows": ["joined_payload_to_accumulator"]
    },
    {
      "name": "accumulate_on_accept",
      "kind": "enable_rule",
      "when": {
        "all_of": [
          {"signal": "accumulator.sample_valid", "op": "==", "value": 1},
          {"signal": "accumulator.sample_ready", "op": "==", "value": 1}
        ]
      },
      "effect": {"action": "update", "target": "sum_q"},
      "related_state": ["sum_q"],
      "related_flows": ["joined_payload_to_accumulator", "accumulator_to_output"]
    },
    {
      "name": "output_backpressure_hold",
      "kind": "stall_rule",
      "when": {
        "all_of": [
          {"signal": "out_stage.out_valid", "op": "==", "value": 1},
          {"signal": "top.out_ready", "op": "==", "value": 0}
        ]
      },
      "effect": {"action": "hold", "target": "accumulator_to_output"},
      "related_state": ["out_valid_q", "out_data_q"],
      "related_flows": ["accumulator_to_output"]
    }
  ],
  "timing": {
    "primary_clock": "clk",
    "target_fmax_mhz": 100,
    "constraints": ["constraints/timing.sdc"]
  },
  "resources": {
    "optimization_goal": "area_first",
    "expected": {
      "lut": "low",
      "ff": "low",
      "bram": 0,
      "dsp": 0
    }
  },
  "verification": {
    "testbench": "sim/tb_top.v",
    "scenarios": [
      {
        "name": "basic_join_accumulate",
        "stimulus": "send one valid sample on each input stream while out_ready is high",
        "expected": "one output sample appears and equals the accumulated joined value",
        "related_flows": ["input0_payload_to_join", "input1_payload_to_join", "accumulator_to_output"],
        "related_control": ["join_fire", "accumulate_on_accept"]
      },
      {
        "name": "input_skew",
        "stimulus": "send input stream 0 before input stream 1",
        "expected": "stream 0 sample is buffered until stream 1 sample arrives",
        "related_flows": ["input0_payload_to_join", "input1_payload_to_join"],
        "related_control": ["join_fire"]
      },
      {
        "name": "output_backpressure",
        "stimulus": "hold out_ready low while out_valid is high",
        "expected": "out_valid and out_data remain stable until out_ready returns high",
        "related_flows": ["accumulator_to_output"],
        "related_control": ["output_backpressure_hold"]
      }
    ],
    "pass_condition": "testbench prints TEST_PASS and no TEST_FAIL"
  },
  "artifacts": {
    "top_module": "top",
    "rtl_sources": [
      "rtl/top.v",
      "rtl/skid_buffer.v",
      "rtl/stream_join.v",
      "rtl/accumulator_core.v",
      "rtl/stream_stage.v"
    ],
    "testbench": "sim/tb_top.v",
    "constraints": ["constraints/timing.sdc"],
    "manifest": "manifest.json",
    "predicted_qor": "reports/predicted_qor.json"
  }
}
