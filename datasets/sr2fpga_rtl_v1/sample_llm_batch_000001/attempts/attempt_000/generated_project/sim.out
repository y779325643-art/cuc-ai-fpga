#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x1015c4ac0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x1015c5de0 .scope module, "tb_top" "tb_top" 3 1;
 .timescale 0 0;
v0x1015cbe00_0 .var "clk", 0 0;
v0x1015cbea0_0 .net "count", 5 0, v0x1015cbcc0_0;  1 drivers
v0x1015cbf40_0 .var "fail", 0 0;
v0x1015cbfe0_0 .var/i "i", 31 0;
v0x1015cc080_0 .var "rst_n", 0 0;
S_0x1015c5f60 .scope module, "u_top" "top" 3 8, 4 1 0, S_0x1015c5de0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /OUTPUT 6 "count";
v0x1015c4c40_0 .net "clk", 0 0, v0x1015cbe00_0;  1 drivers
v0x1015cbcc0_0 .var "count", 5 0;
v0x1015cbd60_0 .net "rst_n", 0 0, v0x1015cc080_0;  1 drivers
E_0xa92c2c5c0 .event posedge, v0x1015c4c40_0;
    .scope S_0x1015c5f60;
T_0 ;
    %wait E_0xa92c2c5c0;
    %load/vec4 v0x1015cbd60_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 6;
    %assign/vec4 v0x1015cbcc0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x1015cbcc0_0;
    %addi 1, 0, 6;
    %assign/vec4 v0x1015cbcc0_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x1015c5de0;
T_1 ;
    %delay 5, 0;
    %load/vec4 v0x1015cbe00_0;
    %inv;
    %store/vec4 v0x1015cbe00_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x1015c5de0;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1015cbe00_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1015cc080_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1015cbf40_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1015cc080_0, 0, 1;
    %wait E_0xa92c2c5c0;
    %pushi/vec4 1, 0, 32;
    %store/vec4 v0x1015cbfe0_0, 0, 32;
T_2.0 ; Top of for-loop
    %load/vec4 v0x1015cbfe0_0;
    %cmpi/s 63, 0, 32;
    %flag_or 5, 4;
	  %jmp/0xz T_2.1, 5;
    %wait E_0xa92c2c5c0;
    %load/vec4 v0x1015cbea0_0;
    %pad/u 32;
    %load/vec4 v0x1015cbfe0_0;
    %cmp/ne;
    %jmp/0xz  T_2.3, 6;
    %vpi_call/w 3 22 "$display", "TEST_FAIL: expected %d, got %d", v0x1015cbfe0_0, v0x1015cbea0_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1015cbf40_0, 0, 1;
T_2.3 ;
T_2.2 ; for-loop step statement
    %load/vec4 v0x1015cbfe0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x1015cbfe0_0, 0, 32;
    %jmp T_2.0;
T_2.1 ; for-loop exit label
    %wait E_0xa92c2c5c0;
    %load/vec4 v0x1015cbea0_0;
    %pad/u 32;
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_2.5, 6;
    %vpi_call/w 3 28 "$display", "TEST_FAIL: expected 0 after wrap, got %d", v0x1015cbea0_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1015cbf40_0, 0, 1;
T_2.5 ;
    %load/vec4 v0x1015cbf40_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_2.7, 8;
    %vpi_call/w 3 32 "$display", "TEST_PASS" {0 0 0};
T_2.7 ;
    %vpi_call/w 3 33 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "sim/tb_top.v";
    "rtl/top.v";
