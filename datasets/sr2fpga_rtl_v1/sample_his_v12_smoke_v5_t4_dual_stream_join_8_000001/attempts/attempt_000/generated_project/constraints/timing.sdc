create_clock -period 10 [get_ports clk]
set_input_delay -clock clk 2 [get_ports in0_valid]
set_input_delay -clock clk 2 [get_ports in0_data]
set_input_delay -clock clk 2 [get_ports in1_valid]
set_input_delay -clock clk 2 [get_ports in1_data]
set_input_delay -clock clk 2 [get_ports out_ready]
set_output_delay -clock clk 2 [get_ports in0_ready]
set_output_delay -clock clk 2 [get_ports in1_ready]
set_output_delay -clock clk 2 [get_ports out_valid]
set_output_delay -clock clk 2 [get_ports out_data]
