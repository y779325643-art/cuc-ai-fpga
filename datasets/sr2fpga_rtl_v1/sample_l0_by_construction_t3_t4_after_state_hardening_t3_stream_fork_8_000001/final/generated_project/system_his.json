    "design_goal": "Implement a composed stream fork with skid buffer and two output stages for reliable data duplication.",
    "assumptions": [
      "valid-ready handshake protocol on all stream interfaces",
      "single clock domain, synchronous active-low reset",
      "8-bit data width",
      "data flow latency of 1 cycle from input to each output",
      "fully pipelined, can accept new input every cycle when outputs ready"
    ]
