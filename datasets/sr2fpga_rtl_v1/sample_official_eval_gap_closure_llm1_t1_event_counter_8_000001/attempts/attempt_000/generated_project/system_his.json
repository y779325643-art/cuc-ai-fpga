{
  "schema_version": "system-his-v1.2",
  "intent": {
    "user_prompt": "Build an 8-bit event-counting subsystem as a complete SR2FPGA Verilog RTL project. This is component topology t1_event_counter, difficulty tier T1. Use an event_gate in front of a counter_core. The design must implement this black-box behavior: event_valid pulses pass through an event gate and increment the counter core. Keep rtl/top.v as the integration wrapper and keep each reusable component in a separate RTL file. Preserve these interface contracts: top.event_valid -> event_gate.event_valid; event_gate.count_en -> counter_core.en; counter_core.count -> top.count. Include system_his.json, manifest.json, timing constraints, predicted QoR, and a bounded self-checking testbench that prints TEST_PASS only on success or TEST_FAIL on failure.",
    "design_goal": "Implement an event-counting subsystem where event_valid pulses are passed through an event gate to enable an 8-bit counter core.",
    "assumptions": [
      "Default clock and reset provided at top level.",
      "Counter core increments on every enabled cycle.",
      "Event gate passes event_valid to count_en without latency.",
      "Reset is active low synchronous."
    ]
  },
  "top": {
    "name": "top",
    "parameters": [],
    "clocks": [
      {
        "name": "clk",
        "target_fmax_mhz": 100.0
      }
    ],
    "resets": [
      {
        "name": "rst_n",
        "polarity": "active_low",
        "kind": "sync"
      }
    ],
    "ports": [
      {
        "name": "event_valid",
        "direction": "input",
        "width": {
          "expr": "1",
          "resolved": 1
        }
      },
      {
        "name": "count",
        "direction": "output",
        "width": {
          "expr": "8",
          "resolved": 8
        }
      },
      {
        "name": "clk",
        "direction": "input",
        "width": {
          "expr": "1",
          "resolved": 1
        }
      },
      {
        "name": "rst_n",
        "direction": "input",
        "width": {
          "expr": "1",
          "resolved": 1
        }
      }
    ],
    "interfaces": []
  },
  "state": {
    "registers": [],
    "counters": [
      {
        "name": "counter_value",
        "width": {
          "expr": "WIDTH",
          "resolved": 8
        },
        "initial_value": 0,
        "owned_by": "counter"
      }
    ],
    "fsms": [],
    "buffers": [],
    "memories": []
  },
  "components": [
    {
      "name": "event_gate",
      "semantic_kind": "combinational_gate",
      "source": "rtl/event_gate.v",
      "parameters": [],
      "ports": [
        {
          "name": "event_valid",
          "direction": "input",
          "width": {
            "expr": "1",
            "resolved": 1
          }
        },
        {
          "name": "count_en",
          "direction": "output",
          "width": {
            "expr": "1",
            "resolved": 1
          }
        }
      ],
      "intent": "Passes the event_valid signal to count_en unconditionally, acting as a buffer."
    },
    {
      "name": "counter_core",
      "semantic_kind": "counter",
      "source": "rtl/counter_core.v",
      "parameters": [
        {
          "name": "WIDTH",
          "default": 8
        }
      ],
      "ports": [
        {
          "name": "clk",
          "direction": "input",
          "width": {
            "expr": "1",
            "resolved": 1
          }
        },
        {
          "name": "rst_n",
          "direction": "input",
          "width": {
            "expr": "1",
            "resolved": 1
          }
        },
        {
          "name": "en",
          "direction": "input",
          "width": {
            "expr": "1",
            "resolved": 1
          }
        },
        {
          "name": "count",
          "direction": "output",
          "width": {
            "expr": "WIDTH",
            "resolved": 8
          }
        }
      ],
      "intent": "8-bit counter that increments when en is high, with synchronous reset to 0."
    }
  ],
  "instances": [
    {
      "name": "event_gate",
      "component": "event_gate",
      "parameter_values": {},
      "clock": "clk",
      "reset": "rst_n",
      "owns_state": []
    },
    {
      "name": "counter",
      "component": "counter_core",
      "parameter_values": {
        "WIDTH": 8
      },
      "clock": "clk",
      "reset": "rst_n",
      "owns_state": [
        "counter_value"
      ]
    }
  ],
  "data_flow": [
    {
      "name": "enable_path",
      "path": [
        "top.event_valid",
        "event_gate.event_valid",
        "event_gate.count_en",
        "counter.en"
      ],
      "payload": {
        "name": "enable_pulse",
        "width": {
          "expr": "1",
          "resolved": 1
        }
      },
      "protocol": "wire",
      "timing": {
        "latency_cycles": 0,
        "initiation_interval": 1,
        "throughput": "one transfer per cycle"
      }
    },
    {
      "name": "count_path",
      "path": [
        "counter.count",
        "top.count"
      ],
      "payload": {
        "name": "count_value",
        "width": {
          "expr": "8",
          "resolved": 8
        }
      },
      "protocol": "wire",
      "timing": {
        "latency_cycles": 1,
        "initiation_interval": 1,
        "throughput": "one transfer per cycle"
      }
    }
  ],
  "control_flow": [
    {
      "name": "reset_counter",
      "kind": "reset_rule",
      "when": {
        "signal": "top.rst_n",
        "op": "==",
        "value": 0
      },
      "effect": {
        "action": "update",
        "target": "counter_value",
        "value": 0
      },
      "related_state": [
        "counter_value"
      ],
      "related_flows": [
        "count_path"
      ]
    },
    {
      "name": "counter_increment",
      "kind": "counter_update",
      "when": {
        "all_of": [
          {
            "signal": "top.event_valid",
            "op": "==",
            "value": 1
          },
          {
            "signal": "top.rst_n",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "increment",
        "target": "counter_value"
      },
      "related_state": [
        "counter_value"
      ],
      "related_flows": [
        "enable_path",
        "count_path"
      ]
    }
  ],
  "timing": {
    "primary_clock": "clk",
    "target_fmax_mhz": 100.0,
    "constraints": [
      "constraints/timing.sdc"
    ]
  },
  "resources": {
    "optimization_goal": "area_first",
    "expected": {
      "lut": "low",
      "ff": "low",
      "bram": 0,
      "dsp": 0
    }
  },
  "verification": {
    "testbench": "sim/tb_top.v",
    "scenarios": [
      "Apply reset and verify count stays at 0",
      "Single event_valid pulse increments count from 0 to 1",
      "Multiple consecutive pulses increment count sequentially",
      "Overflow scenario where count wraps from 255 to 0",
      "Continuous event_valid high increments every cycle"
    ],
    "pass_condition": "testbench prints TEST_PASS and no TEST_FAIL"
  },
  "artifacts": {
    "top_module": "top",
    "rtl_sources": [
      "rtl/top.v",
      "rtl/event_gate.v",
      "rtl/counter_core.v"
    ],
    "testbench": "sim/tb_top.v",
    "constraints": [
      "constraints/timing.sdc"
    ],
    "manifest": "manifest.json",
    "predicted_qor": "reports/predicted_qor.json"
  }
}
