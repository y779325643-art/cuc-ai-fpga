  "data_flow": [
    {
      "name": "input0_to_buffer",
      "path": [
        "top.in0_data",
        "in0_buffer.data_in"
      ],
      "from": "top.in0_data",
      "to": "in0_buffer.data_in",
      "protocol": "valid-ready",
      "width": 8
    },
    {
      "name": "input1_to_buffer",
      "path": [
        "top.in1_data",
        "in1_buffer.data_in"
      ],
      "from": "top.in1_data",
      "to": "in1_buffer.data_in",
      "protocol": "valid-ready",
      "width": 8
    },
    {
      "name": "buffer0_to_join",
      "path": [
        "in0_buffer.data_out",
        "join.data_in0"
      ],
      "from": "in0_buffer.data_out",
      "to": "join.data_in0",
      "protocol": "valid-ready",
      "width": 8
    },
    {
      "name": "buffer1_to_join",
      "path": [
        "in1_buffer.data_out",
        "join.data_in1"
      ],
      "from": "in1_buffer.data_out",
      "to": "join.data_in1",
      "protocol": "valid-ready",
      "width": 8
    },
    {
      "name": "join_to_accumulator",
      "path": [
        "join.data_out",
        "accumulator.data_in"
      ],
      "from": "join.data_out",
      "to": "accumulator.data_in",
      "protocol": "valid-ready",
      "width": 8
    },
    {
      "name": "accumulator_to_output",
      "path": [
        "accumulator.data_out",
        "out_stage.data_in"
      ],
      "from": "accumulator.data_out",
      "to": "out_stage.data_in",
      "protocol": "valid-ready",
      "width": 8
    },
    {
      "name": "output_stage_to_top",
      "path": [
        "out_stage.data_out",
        "top.out_data"
      ],
      "from": "out_stage.data_out",
      "to": "top.out_data",
      "protocol": "valid-ready",
      "width": 8
    }
  ],
  "control_flow": [
    {
      "name": "in0_buffer_load",
      "kind": "handshake_rule",
      "condition": "top.in0_valid && in0_buffer.ready_out",
      "effects": "skid_buf0_data = top.in0_data; skid_buf0_valid = 1",
      "related_state": [
        "skid_buf0_data",
        "skid_buf0_valid"
      ],
      "related_flows": [
        "input0_to_buffer"
      ]
    },
    {
      "name": "in1_buffer_load",
      "kind": "handshake_rule",
      "condition": "top.in1_valid && in1_buffer.ready_out",
      "effects": "skid_buf1_data = top.in1_data; skid_buf1_valid = 1",
      "related_state": [
        "skid_buf1_data",
        "skid_buf1_valid"
      ],
      "related_flows": [
        "input1_to_buffer"
      ]
    },
    {
      "name": "join_handshake",
      "kind": "handshake_rule",
      "condition": "skid_buf0_valid && skid_buf1_valid && accumulator.ready_out",
      "effects": "join.data_out = skid_buf0_data + skid_buf1_data; join.valid_out = 1; skid_buf0_valid = 0; skid_buf1_valid = 0",
      "related_state": [
        "join_fsm",
        "skid_buf0_valid",
        "skid_buf1_valid"
      ],
      "related_flows": [
        "buffer0_to_join",
        "buffer1_to_join"
      ]
    },
    {
      "name": "accumulator_load",
      "kind": "handshake_rule",
      "condition": "join.valid_out && accumulator.ready_in",
      "effects": "accum_reg = accum_reg + join.data_out; accum_valid = 1; join.valid_out = 0",
      "related_state": [
        "accum_reg",
        "accum_valid"
      ],
      "related_flows": [
        "join_to_accumulator"
      ]
    },
    {
      "name": "out_stage_load",
      "kind": "handshake_rule",
      "condition": "accum_valid && out_stage.ready_in",
      "effects": "out_stage_data = accum_reg; out_stage_valid = 1; accum_valid = 0",
      "related_state": [
        "out_stage_data",
        "out_stage_valid",
        "accum_valid"
      ],
      "related_flows": [
        "accumulator_to_output"
      ]
    },
    {
      "name": "top_output_handshake",
      "kind": "handshake_rule",
      "condition": "out_stage_valid && top.out_ready",
      "effects": "top.out_valid = 1; out_stage_valid = 0",
      "related_state": [
        "out_stage_valid"
      ],
      "related_flows": [
        "output_stage_to_top"
      ]
    },
    {
      "name": "join_fsm_idle_to_wait",
      "kind": "fsm_transition",
      "condition": "join_fsm == IDLE && (skid_buf0_valid || skid_buf1_valid)",
      "effects": "join_fsm = WAIT_BOTH",
      "related_state": [
        "join_fsm"
      ],
      "related_flows": []
    },
    {
      "name": "join_fsm_wait_to_output",
      "kind": "fsm_transition",
      "condition": "join_fsm == WAIT_BOTH && skid_buf0_valid && skid_buf1_valid",
      "effects": "join_fsm = OUTPUT",
      "related_state": [
        "join_fsm"
      ],
      "related_flows": []
    },
    {
      "name": "join_fsm_output_to_idle",
      "kind": "fsm_transition",
      "condition": "join_fsm == OUTPUT && join.valid_out && accumulator.ready_in",
      "effects": "join_fsm = IDLE",
      "related_state": [
        "join_fsm"
      ],
      "related_flows": []
    }
  ],
  "timing": {
    "primary_clock": "clk",
