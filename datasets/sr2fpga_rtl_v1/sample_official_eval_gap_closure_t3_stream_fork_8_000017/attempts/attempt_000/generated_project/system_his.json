        "checks": "No new valid on either output while out0_ready low."
      },
      {
        "name": "backpressure_out1",
        "description": "Deassert out1_ready while out0_ready high; verify stall.",
        "stimuli": "Send sample, then hold out1_ready low.",
        "checks": "No new valid on either output while out1_ready low."
      },
