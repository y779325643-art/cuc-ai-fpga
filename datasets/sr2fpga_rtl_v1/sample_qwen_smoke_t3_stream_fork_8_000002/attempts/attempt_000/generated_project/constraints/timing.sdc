create_clock -period 10.0 [get_ports clk]
set_input_delay -clock clk -max 2.0 [remove_from_collection [all_inputs] clk]
set_input_delay -clock clk -min 1.5 [remove_from_collection [all_inputs] clk]
set_output_delay -clock clk -max 2.0 [all_outputs]
set_output_delay -clock clk -min 1.5 [all_outputs]
set_false_path -from [get_ports rst_n]
