#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x104f9a940 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x104f9aac0 .scope module, "tb_top" "tb_top" 3 1;
 .timescale 0 0;
v0x104fa2b10_0 .var "clk", 0 0;
v0x104fa2bb0_0 .net "count", 7 0, v0x104fa2900_0;  1 drivers
v0x104fa2c70_0 .var "en", 0 0;
v0x104fa2d50_0 .var "rst_n", 0 0;
S_0x104f9d980 .scope module, "uut" "top" 3 8, 4 1 0, S_0x104f9aac0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /INPUT 1 "en";
    .port_info 3 /OUTPUT 8 "count";
v0x104f9db00_0 .net "clk", 0 0, v0x104fa2b10_0;  1 drivers
v0x104fa2900_0 .var "count", 7 0;
v0x104fa29b0_0 .net "en", 0 0, v0x104fa2c70_0;  1 drivers
v0x104fa2a70_0 .net "rst_n", 0 0, v0x104fa2d50_0;  1 drivers
E_0x104f9b250/0 .event negedge, v0x104fa2a70_0;
E_0x104f9b250/1 .event posedge, v0x104f9db00_0;
E_0x104f9b250 .event/or E_0x104f9b250/0, E_0x104f9b250/1;
    .scope S_0x104f9d980;
T_0 ;
    %wait E_0x104f9b250;
    %load/vec4 v0x104fa2a70_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x104fa2900_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x104fa29b0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x104fa2900_0;
    %addi 1, 0, 8;
    %assign/vec4 v0x104fa2900_0, 0;
T_0.2 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x104f9aac0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x104fa2b10_0, 0, 1;
T_1.0 ;
    %delay 5, 0;
    %load/vec4 v0x104fa2b10_0;
    %inv;
    %store/vec4 v0x104fa2b10_0, 0, 1;
    %jmp T_1.0;
T_1.1 ;
    %end;
    .thread T_1;
    .scope S_0x104f9aac0;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x104fa2d50_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x104fa2c70_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x104fa2d50_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x104fa2c70_0, 0, 1;
    %delay 100, 0;
    %load/vec4 v0x104fa2bb0_0;
    %cmpi/e 10, 0, 8;
    %jmp/0xz  T_2.0, 4;
    %vpi_call/w 3 29 "$display", "TEST_PASS" {0 0 0};
    %vpi_call/w 3 30 "$finish" {0 0 0};
    %jmp T_2.1;
T_2.0 ;
    %vpi_call/w 3 32 "$display", "TEST_FAIL at %0t: count = %d", $time, v0x104fa2bb0_0 {0 0 0};
    %vpi_call/w 3 33 "$finish" {0 0 0};
T_2.1 ;
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "sim/tb_top.v";
    "rtl/top.v";
