{
  "project_name": "forced_repair_fifo_16bit",
  "task_type": "fifo",
  "system": {
    "description": "Design a synthesizable Verilog RTL fifo project package with width 16, active-low reset rst_n, self-checking testbench, manifest, timing constraint, and predicted QoR."
  },
  "interface": {
    "clock": "clk",
    "reset": "rst_n",
    "reset_polarity": "active_low",
    "inputs": [
      {
        "name": "clk",
        "width": 1
      },
      {
        "name": "rst_n",
        "width": 1
      },
      {
        "name": "wr_en",
        "width": 1
      },
      {
        "name": "rd_en",
        "width": 1
      },
      {
        "name": "din",
        "width": 16
      }
    ],
    "outputs": [
      {
        "name": "dout",
        "width": 16
      },
      {
        "name": "full",
        "width": 1
      },
      {
        "name": "empty",
        "width": 1
      }
    ]
  },
  "platform": {
    "name": "generic_verilog",
    "vendor": "generic",
    "family": "generic",
    "part": "generic",
    "board": "generic",
    "toolchain": "open_source",
    "clock_hz": 100000000
  },
  "verification": {
    "testbench": "sim/tb_top.v",
    "expected_behavior": "data written into the FIFO is read back in order"
  }
}
