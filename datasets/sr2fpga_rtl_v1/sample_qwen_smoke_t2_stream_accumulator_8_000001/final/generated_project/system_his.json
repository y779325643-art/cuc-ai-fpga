  "control_flow": [
    {
      "name": "accumulator_reset",
      "kind": "reset_rule",
      "when": {
        "signal": "top.rst_n",
        "op": "==",
        "value": 0
      },
      "effect": {
        "action": "assign",
        "target": "accum_reg",
        "value": 0
      },
      "related_state": [
        "accum_reg"
      ],
      "related_flows": []
    },
    {
      "name": "accumulator_update",
      "kind": "enable_rule",
      "when": {
        "all_of": [
          {
            "signal": "accumulator.s_valid",
            "op": "==",
            "value": 1
          },
          {
            "signal": "accumulator.s_ready",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "update_register",
        "target": "accum_reg",
        "expression": "accum_reg + accumulator.s_data"
      },
      "related_state": [
        "accum_reg"
      ],
      "related_flows": [
        "input_stream"
      ]
    },
    {
      "name": "output_valid_control",
      "kind": "enable_rule",
      "when": {
        "signal": "accum_reg",
        "op": "!=",
        "value": 0
      },
      "effect": {
        "action": "assert",
        "target": "input_stream"
      },
      "related_state": [
        "accum_reg"
      ],
      "related_flows": [
        "input_stream"
      ]
    }
