{
  "project_name": "pwm_controller_12bit",
  "task_type": "pwm_controller",
  "system": {
    "description": "Design a multi-module Verilog RTL pwm_controller project package with width 12, active-low reset rst_n, self-checking testbench, manifest, timing constraint, and predicted QoR."
  },
  "interface": {
    "clock": "clk",
    "reset": "rst_n",
    "reset_polarity": "active_low",
    "inputs": [
      {
        "name": "clk",
        "width": 1
      },
      {
        "name": "rst_n",
        "width": 1
      },
      {
        "name": "duty",
        "width": 12
      }
    ],
    "outputs": [
      {
        "name": "pwm_out",
        "width": 1
      }
    ]
  },
  "architecture": {
    "style": "multi_module",
    "top_module": "top",
    "submodules": [
      "pwm_timer",
      "pwm_channel"
    ]
  },
  "platform": {
    "name": "generic_verilog",
    "vendor": "generic",
    "family": "generic",
    "part": "generic",
    "board": "generic",
    "toolchain": "open_source",
    "clock_hz": 100000000
  },
  "verification": {
    "testbench": "sim/tb_top.v",
    "expected_behavior": "pwm_out is high when the free-running counter is below duty"
  }
}
