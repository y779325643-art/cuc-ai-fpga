E_0x100d406d0 .event posedge, v0x100d416c0_0;
S_0x100d3bab0 .scope module, "dut" "top" 3 11, 4 1 0, S_0x100d3b930;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /INPUT 1 "we";
    .port_info 3 /INPUT 2 "addr";
    .port_info 4 /INPUT 8 "wdata";
    .port_info 5 /OUTPUT 8 "rdata";
v0x100d41620_0 .net "addr", 1 0, v0x92f034000_0;  1 drivers
v0x100d416c0_0 .net "clk", 0 0, v0x92f0340a0_0;  1 drivers
v0x100d41760_0 .var/i "i", 31 0;
v0x100d41800 .array "mem", 3 0, 7 0;
v0x100d418a0_0 .var "rdata", 7 0;
v0x100d41940_0 .net "rst_n", 0 0, v0x92f0341e0_0;  1 drivers
v0x100d419e0_0 .net "wdata", 7 0, v0x92f034280_0;  1 drivers
v0x100d41a80_0 .net "we", 0 0, v0x92f034320_0;  1 drivers
E_0x100d38d00/0 .event negedge, v0x100d41940_0;
E_0x100d38d00/1 .event posedge, v0x100d416c0_0;
E_0x100d38d00 .event/or E_0x100d38d00/0, E_0x100d38d00/1;
    .scope S_0x100d3bab0;
T_0 ;
    %wait E_0x100d38d00;
    %load/vec4 v0x100d41940_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x100d418a0_0, 0;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x100d41760_0, 0, 32;
T_0.2 ; Top of for-loop
    %load/vec4 v0x100d41760_0;
    %cmpi/s 4, 0, 32;
	  %jmp/0xz T_0.3, 5;
    %pushi/vec4 0, 0, 8;
    %ix/getv/s 3, v0x100d41760_0;
    %ix/load 4, 0, 0; Constant delay
    %assign/vec4/a/d v0x100d41800, 0, 4;
T_0.4 ; for-loop step statement
    %load/vec4 v0x100d41760_0;
    %addi 1, 0, 32;
    %store/vec4 v0x100d41760_0, 0, 32;
    %jmp T_0.2;
T_0.3 ; for-loop exit label
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x100d41a80_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.5, 8;
    %load/vec4 v0x100d419e0_0;
    %load/vec4 v0x100d41620_0;
    %pad/u 4;
    %ix/vec4 3;
    %ix/load 4, 0, 0; Constant delay
    %assign/vec4/a/d v0x100d41800, 0, 4;
T_0.5 ;
    %load/vec4 v0x100d41620_0;
    %pad/u 4;
    %ix/vec4 4;
    %load/vec4a v0x100d41800, 4;
    %assign/vec4 v0x100d418a0_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x100d3b930;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x92f0340a0_0, 0, 1;
T_1.0 ;
    %delay 5000, 0;
    %load/vec4 v0x92f0340a0_0;
    %inv;
    %store/vec4 v0x92f0340a0_0, 0, 1;
    %jmp T_1.0;
T_1.1 ;
    %end;
    .thread T_1;
    .scope S_0x100d3b930;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x92f0341e0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x92f034320_0, 0, 1;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x92f034000_0, 0, 2;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x92f034280_0, 0, 8;
    %pushi/vec4 2, 0, 32;
T_2.0 %dup/vec4;
    %cmpi/s 0, 0, 32;
    %jmp/1xz T_2.1, 5;
    %jmp/1 T_2.1, 4;
    %subi 1, 0, 32;
    %wait E_0x100d406d0;
    %jmp T_2.0;
T_2.1 ;
    %pop/vec4 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x92f0341e0_0, 0, 1;
    %wait E_0x100d405b0;
    %pushi/vec4 2, 0, 2;
    %store/vec4 v0x92f034000_0, 0, 2;
    %pushi/vec4 99, 0, 8;
    %store/vec4 v0x92f034280_0, 0, 8;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x92f034320_0, 0, 1;
    %wait E_0x100d405b0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x92f034320_0, 0, 1;
    %wait E_0x100d405b0;
    %load/vec4 v0x92f034140_0;
    %cmpi/ne 99, 0, 8;
    %jmp/0xz  T_2.2, 6;
    %vpi_call/w 3 41 "$display", "TEST_FAIL expected rdata=99 got %0d", v0x92f034140_0 {0 0 0};
    %vpi_call/w 3 42 "$finish" {0 0 0};
T_2.2 ;
    %vpi_call/w 3 44 "$display", "TEST_PASS" {0 0 0};
    %vpi_call/w 3 45 "$finish" {0 0 0};
    %end;
    .thread T_2;
