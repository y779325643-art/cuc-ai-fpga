 .timescale 0 0;
S_0x100d3b930 .scope module, "tb_top" "tb_top" 3 3;
 .timescale -9 -12;
v0x92f034000_0 .var "addr", 1 0;
v0x92f0340a0_0 .var "clk", 0 0;
v0x92f034140_0 .net "rdata", 7 0, v0x100d418a0_0;  1 drivers
v0x92f0341e0_0 .var "rst_n", 0 0;
v0x92f034280_0 .var "wdata", 7 0;
v0x92f034320_0 .var "we", 0 0;
