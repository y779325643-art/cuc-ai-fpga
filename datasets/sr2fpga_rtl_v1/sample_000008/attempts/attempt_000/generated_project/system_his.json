{
  "project_name": "simple_fsm_4bit",
  "task_type": "simple_fsm",
  "system": {
    "description": "Design a simple FSM with start/done handshake, state visibility, active-low reset, no vendor IP."
  },
  "interface": {
    "clock": "clk",
    "reset": "rst_n",
    "reset_polarity": "active_low",
    "inputs": [
      {
        "name": "clk",
        "width": 1
      },
      {
        "name": "rst_n",
        "width": 1
      },
      {
        "name": "start",
        "width": 1
      }
    ],
    "outputs": [
      {
        "name": "done",
        "width": 1
      },
      {
        "name": "state_value",
        "width": 4
      }
    ]
  },
  "platform": {
    "name": "generic_verilog",
    "vendor": "generic",
    "family": "generic",
    "part": "generic",
    "board": "generic",
    "toolchain": "open_source",
    "clock_hz": 100000000
  },
  "verification": {
    "testbench": "sim/tb_top.v",
    "expected_behavior": "FSM transitions from idle to run to done and back to idle"
  }
}
