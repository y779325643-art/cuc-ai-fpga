{
  "schema_version": "system-his-v1.2",
  "intent": {
    "user_prompt": "Generate an 8-bit FPGA RTL project that implements a synchronous counter with enable and reset.",
    "design_goal": "Implement an 8-bit synchronous up-counter with active-high enable and active-low synchronous reset, wrapping around at maximum count.",
    "assumptions": [
      "Enable is active high.",
      "Reset is active low and synchronous.",
      "Counter wraps from 255 to 0."
    ]
  },
  "top": {
    "name": "top",
    "parameters": [],
    "clocks": [
      {
        "name": "clk",
        "frequency_hz": 100000000,
        "target_fmax_mhz": 100.0
      }
    ],
    "resets": [
      {
        "name": "rst_n",
        "polarity": "active_low",
        "kind": "sync"
      }
    ],
    "ports": [
      {
        "name": "clk",
        "direction": "input",
        "width": 1,
        "clock": "clk"
      },
      {
        "name": "rst_n",
        "direction": "input",
        "width": 1,
        "reset": "rst_n"
      },
      {
        "name": "en",
        "direction": "input",
        "width": 1
      },
      {
        "name": "count",
        "direction": "output",
        "width": 8
      }
    ],
    "interfaces": []
  },
  "state": {
    "registers": [],
    "counters": [
      {
        "name": "cnt",
        "width": 8,
        "owner": "cnt_inst",
        "description": "8-bit counter register."
      }
    ],
    "fsms": [],
    "buffers": [],
    "memories": []
  },
  "components": [
    {
      "name": "counter",
      "semantic_kind": "counter",
      "source": "rtl/counter.v",
      "parameters": [
        {
          "name": "WIDTH",
          "type": "integer",
          "default": 8
        }
      ],
      "ports": [
        {
          "name": "clk",
          "direction": "input",
          "width": 1
        },
        {
          "name": "rst_n",
          "direction": "input",
          "width": 1
        },
        {
          "name": "en",
          "direction": "input",
          "width": 1
        },
        {
          "name": "count",
          "direction": "output",
          "width": "WIDTH"
        }
      ],
      "intent": "Synchronous up-counter with enable and reset."
    },
    {
      "name": "top",
      "semantic_kind": "top",
      "source": "rtl/top.v",
      "parameters": [],
      "ports": [
        {
          "name": "clk",
          "direction": "input",
          "width": 1,
          "clock": "clk"
        },
        {
          "name": "rst_n",
          "direction": "input",
          "width": 1,
          "reset": "rst_n"
        },
        {
          "name": "en",
          "direction": "input",
          "width": 1
        },
        {
          "name": "count",
          "direction": "output",
          "width": 8
        }
      ],
      "intent": "Top-level wrapper that instantiates an 8-bit counter."
    }
  ],
  "instances": [
    {
      "name": "cnt_inst",
      "component": "counter",
      "parameter_values": {
        "WIDTH": 8
      },
      "clock": "clk",
      "reset": "rst_n",
      "owns_state": [
        "cnt"
      ]
    }
  ],
  "data_flow": [
    {
      "name": "counter_data_path",
      "path": [
        "top.en",
        "cnt_inst.en",
        "cnt_inst.count",
        "top.count"
      ],
      "payload": {
        "name": "count_value",
        "width": 8
      },
      "protocol": "continuous",
      "timing": {
        "latency_cycles": 1,
        "initiation_interval": 1,
        "throughput": "one count per cycle"
      }
    }
  ],
  "control_flow": [
    {
      "name": "reset_counter",
      "kind": "reset_rule",
      "when": {
        "signal": "top.rst_n",
        "op": "==",
        "value": 0
      },
      "effect": {
        "action": "set",
        "target": "cnt",
        "value": 0
      },
      "related_state": [
        "cnt"
      ],
      "related_flows": [
        "counter_data_path"
      ]
    },
    {
      "name": "counter_increment",
      "kind": "counter_update",
      "when": {
        "all_of": [
          {
            "signal": "top.rst_n",
            "op": "==",
            "value": 1
          },
          {
            "signal": "top.en",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "increment",
        "target": "cnt"
      },
      "related_state": [
        "cnt"
      ],
      "related_flows": [
        "counter_data_path"
      ]
    }
  ],
  "timing": {
    "primary_clock": "clk",
    "target_fmax_mhz": 100.0,
    "constraints": [
      "constraints/timing.sdc"
    ]
  },
  "resources": {
    "optimization_goal": "area_first",
    "expected": {
      "lut": "low",
      "ff": "low",
      "bram": 0,
      "dsp": 0
    }
  },
  "verification": {
    "testbench": "sim/tb_top.v",
    "scenarios": [
      {
        "name": "reset_test",
        "description": "Assert reset and verify counter resets to 0.",
        "stimuli": "Apply rst_n low for two cycles.",
        "expect": "count == 0"
      },
      {
        "name": "count_enabled",
        "description": "With enable high and reset inactive, counter increments each cycle.",
        "stimuli": "Drive rst_n high, en high, run for 10 cycles.",
        "expect": "count == 10"
      },
      {
        "name": "hold_disabled",
        "description": "With enable low, counter holds its value.",
        "stimuli": "After reaching count=5, set en low for 2 cycles.",
        "expect": "count remains 5"
      }
    ],
    "pass_condition": "All verification scenarios pass and no assertion failures."
  },
  "artifacts": {
    "top_module": "top",
    "rtl_sources": [
      "rtl/counter.v",
      "rtl/top.v"
    ],
    "testbench": "sim/tb_top.v",
    "constraints": [
      "constraints/timing.sdc"
    ],
    "manifest": "manifest.json",
    "predicted_qor": "reports/predicted_qor.json"
  }
}
