{
  "project_name": "forced_repair_counter_5bit",
  "task_type": "counter",
  "system": {
    "description": "Design a synthesizable Verilog RTL counter project package with width 5, active-low reset rst_n, self-checking testbench, manifest, timing constraint, and predicted QoR."
  },
  "interface": {
    "clock": "clk",
    "reset": "rst_n",
    "reset_polarity": "active_low",
    "inputs": [
      {
        "name": "clk",
        "width": 1
      },
      {
        "name": "rst_n",
        "width": 1
      },
      {
        "name": "en",
        "width": 1
      }
    ],
    "outputs": [
      {
        "name": "count",
        "width": 5
      }
    ]
  },
  "platform": {
    "name": "generic_verilog",
    "vendor": "generic",
    "family": "generic",
    "part": "generic",
    "board": "generic",
    "toolchain": "open_source",
    "clock_hz": 100000000
  },
  "verification": {
    "testbench": "sim/tb_top.v",
    "expected_behavior": "count increments when en is high and holds when en is low"
  }
}
