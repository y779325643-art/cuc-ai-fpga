        "name": "clk",
        "frequency_hz": 100000000,
        "target_fmax_mhz": 100,
        "source": "top.clk"
      }
    ],
    "resets": [
      {
        "name": "rst_n",
        "polarity": "active_low",
        "kind": "sync"
      }
    ],
    "ports": [
      {
        "name": "clk",
        "direction": "input",
        "width": {
          "expr": "1",
          "resolved": 1
        },
        "associated_clock": "clk"
      },
      {
        "name": "rst_n",
        "direction": "input",
        "width": {
          "expr": "1",
          "resolved": 1
        },
        "associated_reset": "rst_n"
      },
      {
        "name": "event_valid",
        "direction": "input",
        "width": {
          "expr": "1",
          "resolved": 1
        }
      },
      {
        "name": "count",
        "direction": "output",
        "width": {
          "expr": "8",
          "resolved": 8
        }
      }
    ],
    "interfaces": []
  },
