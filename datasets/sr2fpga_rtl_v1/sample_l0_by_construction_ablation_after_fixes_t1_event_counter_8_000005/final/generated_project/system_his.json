{
  "schema_version": "system-his-v1.2",
  "intent": {
    "user_prompt": "Build an 8-bit event-counting subsystem as a complete SR2FPGA Verilog RTL project. This is component topology t1_event_counter, difficulty tier T1. Use an event_gate in front of a counter_core. The design must implement this black-box behavior: event_valid pulses pass through an event gate and increment the counter core. Keep rtl/top.v as the integration wrapper and keep each reusable component in a separate RTL file. Preserve these interface contracts: top.event_valid -> event_gate.event_valid; event_gate.count_en -> counter_core.en; counter_core.count -> top.count. Include system_his.json, manifest.json, timing constraints, predicted QoR, and a bounded self-checking testbench that prints TEST_PASS only on success or TEST_FAIL on failure.",
    "design_goal": "8-bit event-counting subsystem comprising an event_gate and a counter_core.",
    "assumptions": [
      "event_valid is synchronous to clk and deasserted after one cycle",
      "rst_n is active low and asserted for at least one cycle to clear the counter",
      "the counter wraps when overflow occurs"
    ]
  },
  "top": {
    "name": "top",
    "parameters": [],
    "clocks": [
