{
  "project_name": "cli_repair_baseline_counter_8bit",
  "task_type": "counter",
  "system": {
    "description": "Design an 8-bit synchronous counter with enable, active-low reset, self-checking testbench, and predicted QoR."
  },
  "interface": {
    "clock": "clk",
    "reset": "rst_n",
    "reset_polarity": "active_low",
    "inputs": [
      {
        "name": "clk",
        "width": 1
      },
      {
        "name": "rst_n",
        "width": 1
      },
      {
        "name": "en",
        "width": 1
      }
    ],
    "outputs": [
      {
        "name": "count",
        "width": 8
      }
    ]
  },
  "platform": {
    "name": "generic_verilog",
    "vendor": "generic",
    "family": "generic",
    "part": "generic",
    "board": "generic",
    "toolchain": "open_source",
    "clock_hz": 100000000
  },
  "verification": {
    "testbench": "sim/tb_top.v",
    "expected_behavior": "count increments when en is high and holds when en is low"
  }
}
