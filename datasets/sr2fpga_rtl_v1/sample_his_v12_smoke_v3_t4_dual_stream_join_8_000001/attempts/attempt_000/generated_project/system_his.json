        "buffer0_storage",
        "buffer1_storage"
      ],
      "related_flows": [
        "buffer0_to_join",
        "buffer1_to_join"
      ]
    },
    {
      "name": "accumulate_on_valid",
      "kind": "enable_rule",
      "condition": "accumulator.s_tvalid and accumulator.s_tready",
      "effects": "Add accumulator.s_tdata to accum_val",
      "related_state": [
        "accum_val"
      ],
      "related_flows": [
        "join_to_accumulator"
      ]
    },
    {
      "name": "output_handshake",
      "kind": "handshake_rule",
      "condition": "out_stage.m_tvalid and top.m_axis_tready",
      "effects": "Output accumulated sample via m_axis_tdata",
