  "control_flow": [
    {
      "name": "reset_accumulator",
      "kind": "reset_rule",
      "when": {
        "signal": "top.rst_n",
        "op": "==",
        "value": 0
      },
      "effect": {
        "action": "clear",
        "target": "acc_reg"
      },
      "related_state": [
        "acc_reg"
      ],
      "related_flows": [
        "acc_stream"
      ]
    },
    {
      "name": "reset_out_stage",
      "kind": "reset_rule",
      "when": {
        "signal": "top.rst_n",
        "op": "==",
        "value": 0
      },
      "effect": {
        "action": "clear",
        "target": "out_reg"
      },
      "related_state": [
        "out_reg"
      ],
      "related_flows": [
        "out_stream"
      ]
    },
    {
      "name": "accumulator_enable",
      "kind": "enable_rule",
      "when": {
        "all_of": [
          {
            "signal": "join_core.out_valid",
            "op": "==",
            "value": 1
          },
          {
            "signal": "accumulator.in_ready",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "capture",
        "target": "acc_reg"
      },
      "related_state": [
        "acc_reg"
      ],
      "related_flows": [
        "join_stream",
        "acc_stream"
      ]
    },
    {
      "name": "out_stage_enable",
      "kind": "enable_rule",
      "when": {
        "all_of": [
          {
            "signal": "accumulator.out_valid",
            "op": "==",
            "value": 1
          },
          {
            "signal": "out_stage.in_ready",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "capture",
        "target": "out_reg"
      },
      "related_state": [
        "out_reg"
      ],
      "related_flows": [
        "acc_stream",
        "out_stream"
      ]
    }
  ],
