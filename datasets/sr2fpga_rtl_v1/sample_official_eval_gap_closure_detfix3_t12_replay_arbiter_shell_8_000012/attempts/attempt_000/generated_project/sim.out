    %vpi_call/w 3 153 "$display", "TEST_FAIL expected irq after sample accepted" {0 0 0};
    %vpi_call/w 3 154 "$finish" {0 0 0};
T_7.5 ;
    %vpi_call/w 3 157 "$display", "TEST_PASS" {0 0 0};
    %vpi_call/w 3 158 "$finish" {0 0 0};
    %end;
    .thread T_7;
