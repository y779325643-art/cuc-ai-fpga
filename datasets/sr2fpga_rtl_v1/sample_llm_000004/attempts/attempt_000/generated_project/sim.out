:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x1037e82e0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x1037e8460 .scope module, "tb_top" "tb_top" 3 1;
 .timescale 0 0;
v0x1037f3260_0 .var "clk", 0 0;
v0x1037f3300_0 .var "en", 0 0;
v0x1037f33a0_0 .net "q", 7 0, v0x1037f3120_0;  1 drivers
v0x1037f3440_0 .var "reset_n", 0 0;
S_0x1037ea9f0 .scope module, "uut" "top" 3 8, 4 1 0, S_0x1037e8460;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset_n";
    .port_info 2 /INPUT 1 "en";
    .port_info 3 /OUTPUT 8 "q";
v0x1037eab70_0 .net "clk", 0 0, v0x1037f3260_0;  1 drivers
v0x1037f3070_0 .net "en", 0 0, v0x1037f3300_0;  1 drivers
v0x1037f3120_0 .var "q", 7 0;
v0x1037f31c0_0 .net "reset_n", 0 0, v0x1037f3440_0;  1 drivers
E_0x1037f22a0/0 .event negedge, v0x1037f31c0_0;
E_0x1037f22a0/1 .event posedge, v0x1037eab70_0;
E_0x1037f22a0 .event/or E_0x1037f22a0/0, E_0x1037f22a0/1;
    .scope S_0x1037ea9f0;
T_0 ;
    %wait E_0x1037f22a0;
    %load/vec4 v0x1037f31c0_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x1037f3120_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x1037f3070_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x1037f3120_0;
    %addi 1, 0, 8;
    %assign/vec4 v0x1037f3120_0, 0;
T_0.2 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x1037e8460;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1037f3260_0, 0, 1;
T_1.0 ;
    %delay 5, 0;
    %load/vec4 v0x1037f3260_0;
    %inv;
    %store/vec4 v0x1037f3260_0, 0, 1;
    %jmp T_1.0;
T_1.1 ;
    %end;
    .thread T_1;
    .scope S_0x1037e8460;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1037f3440_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1037f3300_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1037f3440_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x1037f33a0_0;
    %cmpi/ne 0, 0, 8;
    %jmp/0xz  T_2.0, 6;
    %vpi_call/w 3 28 "$display", "FAIL: q should be 0 after reset" {0 0 0};
    %vpi_call/w 3 29 "$finish" {0 0 0};
T_2.0 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1037f3300_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x1037f33a0_0;
    %cmpi/ne 1, 0, 8;
    %jmp/0xz  T_2.2, 6;
    %vpi_call/w 3 34 "$display", "FAIL: q should be 1 after first enable" {0 0 0};
    %vpi_call/w 3 35 "$finish" {0 0 0};
T_2.2 ;
    %delay 90, 0;
    %load/vec4 v0x1037f33a0_0;
    %cmpi/ne 10, 0, 8;
    %jmp/0xz  T_2.4, 6;
    %vpi_call/w 3 39 "$display", "FAIL: q should be 10 after 10 clocks" {0 0 0};
    %vpi_call/w 3 40 "$finish" {0 0 0};
T_2.4 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1037f3300_0, 0, 1;
    %delay 20, 0;
    %load/vec4 v0x1037f33a0_0;
    %cmpi/ne 10, 0, 8;
    %jmp/0xz  T_2.6, 6;
    %vpi_call/w 3 45 "$display", "FAIL: q should stay 10 when en=0" {0 0 0};
    %vpi_call/w 3 46 "$finish" {0 0 0};
T_2.6 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1037f3440_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x1037f33a0_0;
    %cmpi/ne 0, 0, 8;
    %jmp/0xz  T_2.8, 6;
    %vpi_call/w 3 51 "$display", "FAIL: q should be 0 after reset" {0 0 0};
    %vpi_call/w 3 52 "$finish" {0 0 0};
T_2.8 ;
    %vpi_call/w 3 54 "$display", "TEST_PASS" {0 0 0};
    %vpi_call/w 3 55 "$finish" {0 0 0};
    %end;
    .thread T_2;
