E_0x8a902c6c0 .event posedge, v0x10105e950_0;
S_0x101058c60 .scope module, "dut" "top" 3 11, 4 1 0, S_0x101058ae0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /INPUT 1 "we";
    .port_info 3 /INPUT 2 "addr";
    .port_info 4 /INPUT 16 "wdata";
    .port_info 5 /OUTPUT 16 "rdata";
v0x10105e8b0_0 .net "addr", 1 0, v0x8a8c60000_0;  1 drivers
v0x10105e950_0 .net "clk", 0 0, v0x8a8c600a0_0;  1 drivers
v0x10105e9f0_0 .var/i "i", 31 0;
v0x10105ea90 .array "mem", 3 0, 15 0;
v0x10105eb30_0 .var "rdata", 15 0;
v0x10105ebd0_0 .net "rst_n", 0 0, v0x8a8c601e0_0;  1 drivers
v0x10105ec70_0 .net "wdata", 15 0, v0x8a8c60280_0;  1 drivers
v0x10105ed10_0 .net "we", 0 0, v0x8a8c60320_0;  1 drivers
E_0x8a902c700/0 .event negedge, v0x10105ebd0_0;
E_0x8a902c700/1 .event posedge, v0x10105e950_0;
E_0x8a902c700 .event/or E_0x8a902c700/0, E_0x8a902c700/1;
    .scope S_0x101058c60;
T_0 ;
    %wait E_0x8a902c700;
    %load/vec4 v0x10105ebd0_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 16;
    %assign/vec4 v0x10105eb30_0, 0;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x10105e9f0_0, 0, 32;
T_0.2 ; Top of for-loop
    %load/vec4 v0x10105e9f0_0;
    %cmpi/s 4, 0, 32;
	  %jmp/0xz T_0.3, 5;
    %pushi/vec4 0, 0, 16;
    %ix/getv/s 3, v0x10105e9f0_0;
    %ix/load 4, 0, 0; Constant delay
    %assign/vec4/a/d v0x10105ea90, 0, 4;
T_0.4 ; for-loop step statement
    %load/vec4 v0x10105e9f0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x10105e9f0_0, 0, 32;
    %jmp T_0.2;
T_0.3 ; for-loop exit label
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x10105ed10_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.5, 8;
    %load/vec4 v0x10105ec70_0;
    %load/vec4 v0x10105e8b0_0;
    %pad/u 4;
    %ix/vec4 3;
    %ix/load 4, 0, 0; Constant delay
    %assign/vec4/a/d v0x10105ea90, 0, 4;
T_0.5 ;
    %load/vec4 v0x10105e8b0_0;
    %pad/u 4;
    %ix/vec4 4;
    %load/vec4a v0x10105ea90, 4;
    %assign/vec4 v0x10105eb30_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x101058ae0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x8a8c600a0_0, 0, 1;
T_1.0 ;
    %delay 5000, 0;
    %load/vec4 v0x8a8c600a0_0;
    %inv;
    %store/vec4 v0x8a8c600a0_0, 0, 1;
    %jmp T_1.0;
T_1.1 ;
    %end;
    .thread T_1;
    .scope S_0x101058ae0;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x8a8c601e0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x8a8c60320_0, 0, 1;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x8a8c60000_0, 0, 2;
    %pushi/vec4 0, 0, 16;
    %store/vec4 v0x8a8c60280_0, 0, 16;
    %pushi/vec4 2, 0, 32;
T_2.0 %dup/vec4;
    %cmpi/s 0, 0, 32;
    %jmp/1xz T_2.1, 5;
    %jmp/1 T_2.1, 4;
    %subi 1, 0, 32;
    %wait E_0x8a902c6c0;
    %jmp T_2.0;
T_2.1 ;
    %pop/vec4 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x8a8c601e0_0, 0, 1;
    %wait E_0x8a902c680;
    %pushi/vec4 2, 0, 2;
    %store/vec4 v0x8a8c60000_0, 0, 2;
    %pushi/vec4 99, 0, 16;
    %store/vec4 v0x8a8c60280_0, 0, 16;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x8a8c60320_0, 0, 1;
    %wait E_0x8a902c680;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x8a8c60320_0, 0, 1;
    %wait E_0x8a902c680;
    %load/vec4 v0x8a8c60140_0;
    %cmpi/ne 99, 0, 16;
    %jmp/0xz  T_2.2, 6;
    %vpi_call/w 3 41 "$display", "TEST_FAIL expected rdata=99 got %0d", v0x8a8c60140_0 {0 0 0};
    %vpi_call/w 3 42 "$finish" {0 0 0};
T_2.2 ;
    %vpi_call/w 3 44 "$display", "TEST_PASS" {0 0 0};
    %vpi_call/w 3 45 "$finish" {0 0 0};
    %end;
    .thread T_2;
