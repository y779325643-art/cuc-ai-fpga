  "data_flow": [
    {
      "name": "in0_data_stream",
      "path": [
        "top.in0_data",
        "in0_buffer.data_in",
        "in0_buffer.data_out",
        "join_core.in0_data"
      ],
      "description": "Input stream 0 data path through buffer to join."
    },
    {
      "name": "in1_data_stream",
      "path": [
        "top.in1_data",
        "in1_buffer.data_in",
        "in1_buffer.data_out",
        "join_core.in1_data"
      ],
      "description": "Input stream 1 data path through buffer to join."
    },
    {
      "name": "join_data_stream",
      "path": [
        "join_core.out_data",
        "accumulator.data_in"
      ],
      "description": "Joined 16-bit data to accumulator."
    },
    {
      "name": "accum_data_stream",
      "path": [
        "accumulator.data_out",
        "out_stage.data_in"
      ],
      "description": "Accumulated 8-bit data to output stage."
    },
    {
      "name": "out_data_stream",
      "path": [
        "out_stage.data_out",
        "top.out_data"
      ],
      "description": "Final output data to top-level port."
    }
  ],
  "control_flow": [
    {
      "name": "reset_all",
      "kind": "reset_rule",
      "condition": "top.rst_n == 0",
      "effects": "All registers and state machines reset to initial values.",
      "related_state": [
        "acc_reg",
        "join_count",
        "join_fsm"
      ],
      "related_flows": []
    },
    {
      "name": "in0_handshake",
      "kind": "handshake_rule",
      "condition": "in0_buffer.valid_out and join_core.in0_ready",
      "effects": "in0_buffer data transferred to join_core.",
      "related_state": [],
      "related_flows": [
        "in0_data_stream"
      ]
    },
    {
      "name": "in1_handshake",
      "kind": "handshake_rule",
      "condition": "in1_buffer.valid_out and join_core.in1_ready",
      "effects": "in1_buffer data transferred to join_core.",
      "related_state": [],
      "related_flows": [
        "in1_data_stream"
      ]
    },
    {
      "name": "join_condition",
      "kind": "enable_rule",
      "condition": "in0_buffer.valid_out and in1_buffer.valid_out and join_core.out_ready",
      "effects": "Join operation produces output.",
      "related_state": [
        "join_fsm"
      ],
      "related_flows": [
        "join_data_stream"
      ]
    },
    {
      "name": "accum_update",
      "kind": "counter_update",
      "condition": "accumulator.valid_in and accumulator.ready_out",
      "effects": "Accumulator adds incoming data to acc_reg; join_count increments.",
      "related_state": [
        "acc_reg",
        "join_count"
      ],
      "related_flows": [
        "accum_data_stream"
      ]
    },
    {
      "name": "out_handshake",
      "kind": "handshake_rule",
      "condition": "out_stage.valid_out and top.out_ready",
      "effects": "Output data transferred to top-level.",
      "related_state": [],
      "related_flows": [
        "out_data_stream"
      ]
    },
    {
      "name": "stall_propagation",
      "kind": "stall_rule",
      "condition": "not out_stage.ready_in",
      "effects": "Backpressure propagates through accumulator and join.",
      "related_state": [],
      "related_flows": [
        "out_data_stream",
        "accum_data_stream",
        "join_data_stream"
      ]
    }
  ],
  "timing": {
    "primary_clock": "clk",
    "target_fmax_mhz": 100,
    "constraints": [
      "constraints/timing.sdc"
    ]
