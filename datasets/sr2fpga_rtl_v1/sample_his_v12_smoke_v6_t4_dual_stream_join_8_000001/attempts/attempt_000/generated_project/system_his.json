      {
        "name": "basic_join_and_accumulate",
        "description": "Drive two input streams with fixed values, observe output accumulation.",
        "pass_condition": "Output equals expected accumulated sum after each join."
      },
      {
        "name": "backpressure_stall",
        "description": "Assert out_ready low intermittently to verify stall and resume.",
        "pass_condition": "No data loss and correct final value."
      }
    ],
    "pass_condition": "testbench prints TEST_PASS and no TEST_FAIL"
  },
