    %load/vec4 v0x77103bac0_0;
    %cmpi/ne 1, 0, 1;
    %jmp/0xz  T_5.5, 6;
    %vpi_call/w 3 65 "$display", "TEST_FAIL joined output not valid" {0 0 0};
    %vpi_call/w 3 66 "$finish" {0 0 0};
T_5.5 ;
    %load/vec4 v0x77103b980_0;
    %cmpi/ne 8, 0, 12;
    %jmp/0xz  T_5.7, 6;
    %vpi_call/w 3 69 "$display", "TEST_FAIL expected joined sum=%0d got %0d", 32'sb00000000000000000000000000001000, v0x77103b980_0 {0 0 0};
    %vpi_call/w 3 70 "$finish" {0 0 0};
T_5.7 ;
    %load/vec4 v0x77103b660_0;
    %cmpi/ne 1, 0, 1;
    %jmp/1 T_5.11, 6;
    %flag_mov 8, 6;
    %load/vec4 v0x77103b840_0;
    %cmpi/ne 1, 0, 1;
    %flag_or 6, 8;
T_5.11;
    %jmp/0xz  T_5.9, 6;
    %vpi_call/w 3 73 "$display", "TEST_FAIL joined inputs not ready" {0 0 0};
    %vpi_call/w 3 74 "$finish" {0 0 0};
T_5.9 ;
    %vpi_call/w 3 76 "$display", "TEST_PASS" {0 0 0};
    %vpi_call/w 3 77 "$finish" {0 0 0};
    %end;
    .thread T_5;
