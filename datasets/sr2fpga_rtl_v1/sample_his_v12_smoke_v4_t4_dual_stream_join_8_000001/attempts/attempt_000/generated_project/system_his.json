  "control_flow": [
    {
      "name": "global_reset",
      "kind": "reset_rule",
      "condition": "!rst_n",
      "effects": "Clear all registers, counters, and buffers to zero.",
      "related_state": [
        "acc_reg",
        "out_data_reg",
        "in0_occupancy",
        "in1_occupancy"
      ],
      "related_flows": []
    },
    {
      "name": "in0_push_handshake",
      "kind": "handshake_rule",
      "condition": "in0_buffer.in_valid & in0_buffer.in_ready",
      "effects": "Write in0_data into in0_buf and increment in0_occupancy.",
      "related_state": [
        "in0_buf",
        "in0_occupancy"
      ],
      "related_flows": [
        "in0_data_path",
        "in0_valid_path",
        "in0_ready_path"
      ]
    },
    {
      "name": "in0_pop_handshake",
      "kind": "handshake_rule",
      "condition": "in0_buffer.out_valid & in0_buffer.out_ready",
      "effects": "Read from in0_buf and decrement in0_occupancy.",
      "related_state": [
        "in0_buf",
        "in0_occupancy"
      ],
      "related_flows": [
        "join_in0_data_path",
        "join_in0_valid_path",
        "join_in0_ready_path"
      ]
    },
    {
      "name": "in1_push_handshake",
      "kind": "handshake_rule",
      "condition": "in1_buffer.in_valid & in1_buffer.in_ready",
      "effects": "Write in1_data into in1_buf and increment in1_occupancy.",
      "related_state": [
        "in1_buf",
        "in1_occupancy"
      ],
      "related_flows": [
        "in1_data_path",
        "in1_valid_path",
        "in1_ready_path"
      ]
    },
    {
      "name": "in1_pop_handshake",
      "kind": "handshake_rule",
      "condition": "in1_buffer.out_valid & in1_buffer.out_ready",
      "effects": "Read from in1_buf and decrement in1_occupancy.",
      "related_state": [
        "in1_buf",
        "in1_occupancy"
      ],
      "related_flows": [
        "join_in1_data_path",
        "join_in1_valid_path",
        "join_in1_ready_path"
      ]
    },
    {
      "name": "join_input_handshake",
      "kind": "handshake_rule",
      "condition": "join_core.in0_valid & join_core.in1_valid & join_core.out_ready",
      "effects": "Compute sum of in0 and in1, present on out_data.",
      "related_state": [],
      "related_flows": [
        "join_in0_data_path",
        "join_in0_valid_path",
        "join_in0_ready_path",
        "join_in1_data_path",
        "join_in1_valid_path",
        "join_in1_ready_path",
        "acc_in_data_path",
        "acc_in_valid_path",
        "acc_in_ready_path"
      ]
    },
    {
      "name": "acc_input_handshake",
      "kind": "handshake_rule",
      "condition": "accumulator.in_valid & accumulator.in_ready",
      "effects": "Add in_data to acc_reg and update acc_reg.",
      "related_state": [
        "acc_reg"
      ],
      "related_flows": [
        "acc_in_data_path",
        "acc_in_valid_path",
        "acc_in_ready_path"
      ]
    },
    {
      "name": "acc_output_handshake",
      "kind": "handshake_rule",
      "condition": "accumulator.out_valid & accumulator.out_ready",
      "effects": "Transfer acc_reg to out_stage.",
      "related_state": [
        "acc_reg",
        "out_data_reg"
      ],
      "related_flows": [
        "acc_out_data_path",
        "acc_out_valid_path",
        "acc_out_ready_path"
      ]
    },
    {
      "name": "out_handshake",
      "kind": "handshake_rule",
      "condition": "out_stage.out_valid & out_stage.out_ready",
      "effects": "Transfer out_data_reg to top.out_data.",
      "related_state": [
        "out_data_reg"
      ],
      "related_flows": [
        "out_data_path",
        "out_valid_path",
        "out_ready_path"
      ]
    },
    {
      "name": "clear_rule",
      "kind": "enable_rule",
      "condition": "top.clear",
      "effects": "Reset acc_reg to 0 on next clock edge.",
      "related_state": [
        "acc_reg"
      ],
      "related_flows": [
        "clear_path"
      ]
    },
    {
      "name": "in0_occupancy_update",
      "kind": "counter_update",
      "condition": "in0_push_handshake or in0_pop_handshake",
      "effects": "Update in0_occupancy accordingly.",
      "related_state": [
        "in0_occupancy"
      ],
      "related_flows": [
        "in0_data_path",
        "in0_valid_path",
        "in0_ready_path",
        "join_in0_data_path",
        "join_in0_valid_path",
        "join_in0_ready_path"
      ]
    },
    {
      "name": "in1_occupancy_update",
      "kind": "counter_update",
      "condition": "in1_push_handshake or in1_pop_handshake",
      "effects": "Update in1_occupancy accordingly.",
      "related_state": [
        "in1_occupancy"
      ],
      "related_flows": [
        "in1_data_path",
        "in1_valid_path",
        "in1_ready_path",
        "join_in1_data_path",
        "join_in1_valid_path",
        "join_in1_ready_path"
      ]
    }
  ],
