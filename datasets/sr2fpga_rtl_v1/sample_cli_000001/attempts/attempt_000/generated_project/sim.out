:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x104f642e0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x104f64460 .scope module, "tb_top" "tb_top" 3 3;
 .timescale -9 -12;
v0x104f6dbd0_0 .var "clk", 0 0;
v0x104f6dc70_0 .net "count", 7 0, v0x104f67210_0;  1 drivers
v0x104f6dd10_0 .var "en", 0 0;
v0x104f6ddb0_0 .var "rst_n", 0 0;
E_0x104f6c1e0 .event posedge, v0x104f67170_0;
S_0x104f66ff0 .scope module, "dut" "top" 3 9, 4 1 0, S_0x104f64460;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /INPUT 1 "en";
    .port_info 3 /OUTPUT 8 "count";
v0x104f67170_0 .net "clk", 0 0, v0x104f6dbd0_0;  1 drivers
v0x104f67210_0 .var "count", 7 0;
v0x104f6da90_0 .net "en", 0 0, v0x104f6dd10_0;  1 drivers
v0x104f6db30_0 .net "rst_n", 0 0, v0x104f6ddb0_0;  1 drivers
E_0x104f6c310/0 .event negedge, v0x104f6db30_0;
E_0x104f6c310/1 .event posedge, v0x104f67170_0;
E_0x104f6c310 .event/or E_0x104f6c310/0, E_0x104f6c310/1;
    .scope S_0x104f66ff0;
T_0 ;
    %wait E_0x104f6c310;
    %load/vec4 v0x104f6db30_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x104f67210_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x104f6da90_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x104f67210_0;
    %addi 1, 0, 8;
    %assign/vec4 v0x104f67210_0, 0;
T_0.2 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x104f64460;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x104f6dbd0_0, 0, 1;
T_1.0 ;
    %delay 5000, 0;
    %load/vec4 v0x104f6dbd0_0;
    %inv;
    %store/vec4 v0x104f6dbd0_0, 0, 1;
    %jmp T_1.0;
T_1.1 ;
    %end;
    .thread T_1;
    .scope S_0x104f64460;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x104f6ddb0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x104f6dd10_0, 0, 1;
    %pushi/vec4 2, 0, 32;
T_2.0 %dup/vec4;
    %cmpi/s 0, 0, 32;
    %jmp/1xz T_2.1, 5;
    %jmp/1 T_2.1, 4;
    %subi 1, 0, 32;
    %wait E_0x104f6c1e0;
    %jmp T_2.0;
T_2.1 ;
    %pop/vec4 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x104f6ddb0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x104f6dd10_0, 0, 1;
    %pushi/vec4 4, 0, 32;
T_2.2 %dup/vec4;
    %cmpi/s 0, 0, 32;
    %jmp/1xz T_2.3, 5;
    %jmp/1 T_2.3, 4;
    %subi 1, 0, 32;
    %wait E_0x104f6c1e0;
    %jmp T_2.2;
T_2.3 ;
    %pop/vec4 1;
    %load/vec4 v0x104f6dc70_0;
    %cmpi/ne 4, 0, 8;
    %jmp/0xz  T_2.4, 6;
    %vpi_call/w 3 29 "$display", "TEST_FAIL expected count=4 got %0d", v0x104f6dc70_0 {0 0 0};
    %vpi_call/w 3 30 "$finish" {0 0 0};
T_2.4 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x104f6dd10_0, 0, 1;
    %pushi/vec4 2, 0, 32;
T_2.6 %dup/vec4;
    %cmpi/s 0, 0, 32;
    %jmp/1xz T_2.7, 5;
    %jmp/1 T_2.7, 4;
    %subi 1, 0, 32;
    %wait E_0x104f6c1e0;
    %jmp T_2.6;
T_2.7 ;
    %pop/vec4 1;
    %load/vec4 v0x104f6dc70_0;
    %cmpi/ne 4, 0, 8;
    %jmp/0xz  T_2.8, 6;
    %vpi_call/w 3 35 "$display", "TEST_FAIL hold failed got %0d", v0x104f6dc70_0 {0 0 0};
    %vpi_call/w 3 36 "$finish" {0 0 0};
T_2.8 ;
    %vpi_call/w 3 38 "$display", "TEST_PASS" {0 0 0};
    %vpi_call/w 3 39 "$finish" {0 0 0};
    %end;
    .thread T_2;
