  "control_flow": [
    {
      "name": "reset_accumulator",
      "kind": "reset_rule",
      "when": {
        "signal": "top.rst_n",
        "op": "==",
        "value": 0
      },
      "effect": {
        "action": "assign",
        "target": "accum_reg",
        "value": 0
      },
      "related_state": [
        "accum_reg"
      ],
      "related_flows": [
        "joined_output_path"
      ]
    },
    {
      "name": "accumulate_when_valid",
      "kind": "enable_rule",
      "when": {
        "all_of": [
          {
            "signal": "accumulator.out_ready",
            "op": "==",
            "value": 1
          },
          {
            "signal": "accumulator.out_valid",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "update_register",
        "target": "accum_reg",
        "expression": "(accum_reg + accumulator.out_data) % 256"
      },
      "related_state": [
        "accum_reg"
      ],
      "related_flows": [
        "joined_output_path"
      ]
    },
    {
      "name": "handshake_input0",
      "kind": "handshake_rule",
      "when": {
        "all_of": [
          {
            "signal": "in0_buffer.out_valid",
            "op": "==",
            "value": 1
          },
          {
            "signal": "join_core.in0_ready",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "assert",
        "target": "input0_path"
      },
      "related_state": [],
      "related_flows": [
        "input0_path"
      ]
    },
    {
      "name": "handshake_input1",
      "kind": "handshake_rule",
      "when": {
        "all_of": [
          {
            "signal": "in1_buffer.out_valid",
            "op": "==",
            "value": 1
          },
          {
            "signal": "join_core.in1_ready",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "assert",
        "target": "input1_path"
      },
      "related_state": [],
      "related_flows": [
        "input1_path"
      ]
    },
    {
      "name": "handshake_joined_to_accum",
      "kind": "handshake_rule",
      "when": {
        "all_of": [
          {
            "signal": "join_core.out_valid",
            "op": "==",
            "value": 1
          },
          {
            "signal": "accumulator.in_ready",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "assert",
        "target": "joined_output_path"
      },
      "related_state": [],
      "related_flows": [
        "joined_output_path"
      ]
    }
  ],
