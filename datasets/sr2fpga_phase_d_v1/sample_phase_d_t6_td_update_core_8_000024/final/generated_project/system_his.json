  "control_flow": [
    {
      "name": "reset_rule",
      "kind": "reset_rule",
      "when": {
        "signal": "top.rst_n",
        "op": "==",
        "value": 0
      },
      "effect": {
        "action": "reset",
        "target": "output_fsm"
      },
      "related_state": [
        "output_fsm"
      ],
      "related_flows": []
    },
    {
      "name": "capture_enable",
      "kind": "enable_rule",
      "when": {
        "all_of": [
          {
            "signal": "top.in_valid",
            "op": "==",
            "value": 1
          },
          {
            "signal": "top.in_ready",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "enable",
        "target": "tuple_capture"
      },
      "related_state": [
        "captured_reward",
        "captured_value",
        "captured_next_value"
      ],
      "related_flows": [
        "tuple_capture"
      ]
    },
    {
      "name": "output_fsm_idle_to_valid",
      "kind": "fsm_transition",
      "fsm": "output_fsm",
      "from": "IDLE",
      "to": "VALID",
      "when": {
        "signal": "output_stage.in_valid",
        "op": "==",
        "value": 1
      },
      "effect": {
        "action": "assert",
        "target": "output_staging"
      },
      "related_state": [
        "output_fsm"
      ],
      "related_flows": [
        "output_staging"
      ]
    },
    {
      "name": "output_fsm_valid_to_idle",
      "kind": "fsm_transition",
      "fsm": "output_fsm",
      "from": "VALID",
      "to": "IDLE",
      "when": {
        "all_of": [
          {
            "signal": "output_stage.out_ready",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "deassert",
        "target": "output_staging"
      },
      "related_state": [
        "output_fsm"
      ],
      "related_flows": [
        "output_staging"
      ]
    }
