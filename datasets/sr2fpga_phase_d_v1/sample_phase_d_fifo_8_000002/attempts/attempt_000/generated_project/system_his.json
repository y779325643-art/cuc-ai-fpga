    "scenarios": [
      {
        "name": "reset_initializes_empty_fifo",
        "description": "Apply synchronous active-low reset and verify the FIFO reports ready for input, not valid for output, and has empty occupancy."
      },
      {
        "name": "single_write_then_read",
        "description": "Accept one 8-bit word, then assert output ready and verify the same word appears on the output with a valid handshake."
      },
      {
        "name": "fill_to_capacity_and_stall",
        "description": "Write four entries without reading and verify input ready deasserts once the FIFO is full."
      },
      {
        "name": "drain_to_empty_and_stall",
        "description": "Read all stored entries and verify output valid deasserts once the FIFO becomes empty."
      },
      {
        "name": "simultaneous_read_write",
        "description": "With the FIFO partially occupied, perform concurrent input and output handshakes and verify occupancy remains constant while data ordering is preserved."
      },
      {
        "name": "backpressure_holds_output",
        "description": "Deassert out_ready while data is available and verify out_valid and out_data remain stable until the output handshake completes."
      },
      {
        "name": "ordering_preserved",
        "description": "Push a sequence of distinct 8-bit values through varied ready/valid stalls and verify first-in first-out ordering at the output."
      }
    ],
    "pass_condition": "testbench prints TEST_PASS and no TEST_FAIL"
