  "control_flow": [
    {
      "name": "reset_state",
      "kind": "reset_rule",
      "when": {
        "signal": "top.rst_n",
        "op": "==",
        "value": 0
      },
      "effect": {
        "action": "reset",
        "target": "occupancy"
      },
      "related_state": [
        "wr_ptr",
        "rd_ptr",
        "occupancy"
      ],
      "related_flows": []
    },
    {
      "name": "write_accept",
      "kind": "handshake_rule",
      "when": {
        "all_of": [
          {
            "signal": "top.wr_valid",
            "op": "==",
            "value": 1
          },
          {
            "signal": "top.wr_ready",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "update",
        "target": "wr_ptr"
      },
      "related_state": [
        "wr_ptr",
        "occupancy",
        "fifo_mem"
      ],
      "related_flows": [
        "write_path"
      ]
    },
    {
