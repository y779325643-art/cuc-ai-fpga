        "op": "<",
        "value": 16
      },
      "effect": {
        "action": "assert",
        "target": "write_path"
      },
      "related_state": [
        "occupancy"
      ],
      "related_flows": [
        "write_path"
      ]
    },
    {
      "name": "rd_valid_gate",
      "kind": "enable_rule",
      "when": {
        "signal": "occupancy",
        "op": ">",
        "value": 0
      },
      "effect": {
        "action": "assert",
        "target": "read_path"
      },
      "related_state": [
        "occupancy"
      ],
      "related_flows": [
        "read_path"
      ]
    },
    {
      "name": "occupancy_increment",
      "kind": "counter_update",
      "when": {
        "all_of": [
          {
            "signal": "top.wr_valid",
            "op": "==",
            "value": 1
          },
          {
            "signal": "top.wr_ready",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "increment",
        "target": "occupancy"
      },
      "related_state": [
        "occupancy"
      ],
      "related_flows": [
        "write_path"
      ]
    },
    {
      "name": "occupancy_decrement",
