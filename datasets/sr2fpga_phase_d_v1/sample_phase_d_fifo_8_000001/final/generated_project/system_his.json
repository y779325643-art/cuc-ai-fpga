  "verification": {
    "testbench": "sim/tb_top.v",
    "scenarios": [
      {
        "name": "reset_clears_fifo",
        "description": "Apply active-low reset and confirm FIFO reports empty with rd_valid deaserted and wr_ready asserted.",
        "pass_condition": "After reset, rd_valid == 0 and wr_ready == 1 and occupancy == 0."
      },
      {
        "name": "single_write_read",
        "description": "Write one word then read it back, checking data integrity through the FIFO.",
        "pass_condition": "rd_data equals the written wr_data and occupancy returns to 0 after read."
      },
      {
        "name": "fill_to_full",
        "description": "Write until FIFO reaches depth and verify wr_ready deasserts at full.",
        "pass_condition": "wr_ready == 0 when occupancy == DEPTH and no further writes are accepted."
      },
      {
        "name": "drain_to_empty",
        "description": "Read all entries and verify rd_valid deaserts at empty.",
        "pass_condition": "rd_valid == 0 when occupancy == 0 and no further reads are accepted."
      },
      {
        "name": "fifo_ordering",
        "description": "Write a sequence of words and read them back, verifying first-in-first-out order.",
        "pass_condition": "Read data sequence matches written data sequence in order."
      },
      {
        "name": "backpressure",
        "description": "Hold rd_ready low while writing and verify data is retained until reads resume.",
        "pass_condition": "No data loss; all words read in order once rd_ready reaserts."
      }
    ],
    "pass_condition": "testbench prints TEST_PASS and no TEST_FAIL"
  },
