  "control_flow": [
    {
      "name": "sync_reset_clears_control_state",
      "kind": "reset_rule",
      "when": {
        "signal": "top.rst_n",
        "op": "==",
        "value": 0
      },
      "effect": {
        "action": "clear",
        "target": "pix_x_count"
      },
      "related_state": [
        "pix_x_count",
        "pix_y_count",
        "stream_fsm",
        "boundary_flag_reg",
        "last_pipeline_reg"
      ],
      "related_flows": []
    },
    {
      "name": "input_acceptance_advances_pipeline",
      "kind": "handshake_rule",
      "when": {
        "all_of": [
          {
            "signal": "top.in_valid",
            "op": "==",
            "value": 1
          },
          {
            "signal": "top.in_ready",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "advance",
        "target": "input_pixel_stream"
      },
      "related_state": [
        "pix_x_count",
        "pix_y_count"
      ],
      "related_flows": [
        "input_pixel_stream",
        "line_aligned_stream",
        "window_stream"
      ]
    },
    {
      "name": "output_backpressure_stalls_pipeline",
      "kind": "stall_rule",
      "when": {
        "all_of": [
          {
            "signal": "top.out_valid",
            "op": "==",
            "value": 1
          },
          {
            "signal": "top.out_ready",
            "op": "==",
            "value": 0
          }
