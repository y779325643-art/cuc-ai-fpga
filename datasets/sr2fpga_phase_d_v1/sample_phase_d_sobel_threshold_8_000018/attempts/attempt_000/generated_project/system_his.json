            "op": "==",
            "value": 1
          },
          {
            "signal": "top.out_last",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "transition",
        "target": "stream_fsm"
      },
      "related_state": [
        "stream_fsm"
      ],
      "related_flows": [
        "output_edge_stream",
        "last_sideband_flow"
      ]
    }
