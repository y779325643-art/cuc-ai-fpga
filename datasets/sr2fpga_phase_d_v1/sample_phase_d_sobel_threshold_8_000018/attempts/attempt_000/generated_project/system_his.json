        "all_of": [
          {
            "signal": "pix_x_count",
            "op": "==",
            "value": 639
          },
          {
            "signal": "top.in_valid",
            "op": "==",
            "value": 1
          },
          {
            "signal": "top.in_ready",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "increment_or_wrap",
