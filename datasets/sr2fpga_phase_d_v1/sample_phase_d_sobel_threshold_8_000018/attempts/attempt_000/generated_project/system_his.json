      },
      "effect": {
        "action": "hold",
        "target": "output_edge_stream"
      },
      "related_state": [
        "pipe_valid_window",
        "pipe_valid_gradient",
        "pipe_valid_threshold",
        "last_pipeline_reg"
      ],
      "related_flows": [
