        "action": "force_low_value",
        "target": "output_edge_stream"
      },
      "related_state": [
        "boundary_flag_reg"
      ],
      "related_flows": [
        "output_edge_stream"
      ]
    },
    {
      "name": "fsm_idle_to_active",
      "kind": "fsm_transition",
      "fsm": "stream_fsm",
      "from": "IDLE",
      "to": "ACTIVE",
      "when": {
        "all_of": [
          {
            "signal": "top.in_valid",
            "op": "==",
            "value": 1
          },
          {
            "signal": "top.in_ready",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "transition",
        "target": "stream_fsm"
      },
      "related_state": [
        "stream_fsm"
      ],
      "related_flows": [
        "input_pixel_stream"
      ]
    },
    {
      "name": "fsm_active_to_flush",
      "kind": "fsm_transition",
      "fsm": "stream_fsm",
      "from": "ACTIVE",
      "to": "FLUSH",
      "when": {
        "all_of": [
