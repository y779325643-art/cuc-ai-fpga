        "default": 8,
        "intent": "Pixel and threshold width in bits."
      },
      {
        "name": "IMG_WIDTH",
        "type": "integer",
        "default": 640,
        "intent": "Number of pixels per image row."
      },
      {
        "name": "IMG_HEIGHT",
        "type": "integer",
        "default": 480,
        "intent": "Number of rows per image frame."
      },
      {
        "name": "EDGE_HIGH_VALUE",
        "type": "integer",
        "default": 255,
        "intent": "Output value used when Sobel magnitude is greater than or equal to threshold."
      },
      {
        "name": "EDGE_LOW_VALUE",
        "type": "integer",
        "default": 0,
        "intent": "Output value used when Sobel magnitude is below threshold or at image boundary."
      }
    ],
