            "signal": "top.in_valid",
            "op": "==",
            "value": 1
          },
          {
            "signal": "top.in_ready",
            "op": "==",
            "value": 1
          }
        ]
      },
      "effect": {
        "action": "transition",
        "target": "stream_fsm"
      },
      "related_state": [
        "stream_fsm",
        "last_pipeline_reg"
      ],
      "related_flows": [
        "input_pixel_stream",
        "last_sideband_flow"
      ]
    },
    {
      "name": "fsm_flush_to_idle",
      "kind": "fsm_transition",
      "fsm": "stream_fsm",
      "from": "FLUSH",
      "to": "IDLE",
      "when": {
