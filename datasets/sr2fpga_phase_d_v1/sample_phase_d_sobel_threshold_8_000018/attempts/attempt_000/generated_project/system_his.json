      "related_state": [
        "pix_x_count",
        "pix_y_count"
      ],
      "related_flows": [
        "input_pixel_stream"
      ]
    },
    {
      "name": "boundary_flag_tracks_frame_edges",
      "kind": "enable_rule",
      "when": {
        "any_of": [
          {
            "signal": "pix_x_count",
            "op": "==",
            "value": 0
          },
          {
            "signal": "pix_y_count",
            "op": "==",
            "value": 0
          },
          {
            "signal": "pix_x_count",
            "op": "==",
            "value": 639
          },
          {
            "signal": "pix_y_count",
            "op": "==",
            "value": 479
          }
        ]
      },
      "effect": {
        "action": "assert",
        "target": "boundary_flag_reg"
      },
      "related_state": [
        "boundary_flag_reg",
        "pix_x_count",
        "pix_y_count"
      ],
      "related_flows": [
        "output_edge_stream"
      ]
    },
    {
      "name": "threshold_forces_low_on_boundary",
      "kind": "enable_rule",
      "when": {
