# Timing constraints for clock clk at 100 MHz
create_clock -name clk -period 10.000 [get_ports clk]
set_clock_uncertainty 0.200 [get_clocks clk]
set_input_delay -clock clk -max 2.000 [get_ports in0_valid]
set_input_delay -clock clk -min 0.500 [get_ports in0_valid]
set_input_delay -clock clk -max 2.000 [get_ports in0_data]
set_input_delay -clock clk -min 0.500 [get_ports in0_data]
set_input_delay -clock clk -max 2.000 [get_ports in1_valid]
set_input_delay -clock clk -min 0.500 [get_ports in1_valid]
set_input_delay -clock clk -max 2.000 [get_ports in1_data]
set_input_delay -clock clk -min 0.500 [get_ports in1_data]
set_output_delay -clock clk -max 2.000 [get_ports out_valid]
set_output_delay -clock clk -min 0.500 [get_ports out_valid]
set_output_delay -clock clk -max 2.000 [get_ports out_data]
set_output_delay -clock clk -min 0.500 [get_ports out_data]
