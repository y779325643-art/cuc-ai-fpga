{
  "checks": {
    "lint": "passed",
    "sim_compile": "passed",
    "sim_run": "passed",
    "synth": "passed"
  },
  "commands": {
    "lint": [
      "/opt/homebrew/bin/verilator",
      "--lint-only",
      "-Wall",
      "rtl/top.v",
      "rtl/td_input_stage.v",
      "rtl/discount_core.v",
      "rtl/td_update_core.v",
      "rtl/stream_stage.v"
    ],
    "sim_compile": [
      "/opt/homebrew/bin/iverilog",
      "-g2012",
      "-o",
      "sim.out",
      "rtl/top.v",
      "rtl/td_input_stage.v",
      "rtl/discount_core.v",
      "rtl/td_update_core.v",
      "rtl/stream_stage.v",
      "sim/tb_top.v"
    ],
    "sim_run": [
      "/opt/homebrew/bin/vvp",
      "sim.out"
    ],
    "synth": [
      "/opt/homebrew/bin/yosys",
      "-p",
      "read_verilog rtl/top.v rtl/td_input_stage.v rtl/discount_core.v rtl/td_update_core.v rtl/stream_stage.v; synth -top top; stat"
    ]
  },
  "pass_level": "L3",
  "testbench_policy": "functional_task_specific_or_fail_safe; no unconditional TEST_PASS skeleton fallback"
}
